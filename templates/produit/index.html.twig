{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1><i class="fas fa-cube"></i> Produits</h1>

    {# Filtres et Recherche #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('produit_index') }}" class="row g-3">
                <div class="col-md-4">
                    <label for="search" class="form-label"><i class="fas fa-search"></i> Rechercher</label>
                    <input type="text" class="form-control" id="search" name="search" 
                           value="{{ app.request.query.get('search', '') }}" 
                           placeholder="Nom du produit, artiste...">
                </div>
                
                {% if categories is defined and categories %}
                <div class="col-md-3">
                    <label for="categorie" class="form-label"><i class="fas fa-filter"></i> Catégorie</label>
                    <select class="form-select" id="categorie" name="categorie">
                        <option value="">Toutes les catégories</option>
                        {% for cat in categories %}
                            <option value="{{ cat }}" {% if selected_categorie == cat %}selected{% endif %}>{{ cat }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                
                <div class="col-md-3">
                    <label for="sort" class="form-label"><i class="fas fa-sort"></i> Trier par</label>
                    <select class="form-select" id="sort" name="sort">
                        <option value="date_desc" {% if app.request.query.get('sort') == 'date_desc' %}selected{% endif %}>Date (récent)</option>
                        <option value="date_asc" {% if app.request.query.get('sort') == 'date_asc' %}selected{% endif %}>Date (ancien)</option>
                        <option value="nom_asc" {% if app.request.query.get('sort') == 'nom_asc' %}selected{% endif %}>Nom (A-Z)</option>
                        <option value="nom_desc" {% if app.request.query.get('sort') == 'nom_desc' %}selected{% endif %}>Nom (Z-A)</option>
                        <option value="prix_asc" {% if app.request.query.get('sort') == 'prix_asc' %}selected{% endif %}>Prix (croissant)</option>
                        <option value="prix_desc" {% if app.request.query.get('sort') == 'prix_desc' %}selected{% endif %}>Prix (décroissant)</option>
                    </select>
                </div>
                
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-check"></i> Appliquer
                    </button>
                </div>
            </form>
        </div>
    </div>

    {% if isCreator %}
        {# Section pour les créateurs (Artiste, Musicien, Scénariste) #}
        
        {# Mes Produits #}
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="mb-0"><i class="fas fa-user-circle"></i> Mes Produits</h3>
                    <a href="{{ path('produit_new') }}" class="btn btn-light btn-sm">
                        <i class="fas fa-plus"></i> Créer un produit
                    </a>
                </div>
            </div>
            <div class="card-body">
                {% if mesProduits is empty %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Vous n'avez pas encore créé de produits.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nom</th>
                                    <th>Prix</th>
                                    <th>Catégorie</th>
                                    <th>Statut</th>
                                    <th>Date création</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for produit in mesProduits %}
                                <tr>
                                    <td><strong>#{{ produit.id }}</strong></td>
                                    <td>{{ produit.nom }}</td>
                                    <td>{{ produit.prix }} €</td>
                                    <td>{{ produit.categorie ? produit.categorie.nom : (produit.categorieLabel ?: '-') }}</td>
                                    <td>
                                        {% if produit.sousContrat %}
                                            <span class="badge bg-warning">Sous contrat</span>
                                        {% else %}
                                            <span class="badge bg-success">Disponible</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ produit.dateCreation ? produit.dateCreation|date('d/m/Y') : '' }}</td>
                                    <td>
                                        <a href="{{ path('produit_show', {'id': produit.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> Voir
                                        </a>
                                        {% if not produit.sousContrat %}
                                            <button class="btn btn-sm btn-warning" disabled>
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" disabled>
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Autres Produits #}
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0"><i class="fas fa-shopping-bag"></i> Produits des Autres Artistes</h3>
            </div>
            <div class="card-body">
                {% if autresProduits is empty %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Aucun autre produit disponible.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nom</th>
                                    <th>Artiste</th>
                                    <th>Prix</th>
                                    <th>Catégorie</th>
                                    <th>Date création</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for produit in autresProduits %}
                                <tr>
                                    <td>{{ produit.id }}</td>
                                    <td>{{ produit.nom }}</td>
                                    <td>{{ produit.artist ? produit.artist.name : '-' }}</td>
                                    <td>{{ produit.prix }} €</td>
                                    <td>{{ produit.categorie ? produit.categorie.nom : (produit.categorieLabel ?: '-') }}</td>
                                    <td>{{ produit.dateCreation ? produit.dateCreation|date('d/m/Y') : '' }}</td>
                                    <td>
                                        <a href="{{ path('produit_show', {'id': produit.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> Voir
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

    {% else %}
        {# Section pour les non-créateurs (Publisher, Sponsor, Utilisateur) #}
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0"><i class="fas fa-shopping-bag"></i> Tous les Produits</h3>
            </div>
            <div class="card-body">
                {% if autresProduits is empty %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Aucun produit disponible.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nom</th>
                                    <th>Artiste</th>
                                    <th>Prix</th>
                                    <th>Catégorie</th>
                                    <th>Date création</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for produit in autresProduits %}
                                <tr>
                                    <td>{{ produit.id }}</td>
                                    <td>{{ produit.nom }}</td>
                                    <td>{{ produit.artist ? produit.artist.name : '-' }}</td>
                                    <td>{{ produit.prix }} €</td>
                                    <td>{{ produit.categorie ? produit.categorie.nom : (produit.categorieLabel ?: '-') }}</td>
                                    <td>{{ produit.dateCreation ? produit.dateCreation|date('d/m/Y') : '' }}</td>
                                    <td>
                                        <a href="{{ path('produit_show', {'id': produit.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> Voir
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
