{% extends 'base.html.twig' %}

{% block title %}Modifier Contrat{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">
                        <i class="fas fa-edit"></i> Modifier le Contrat #{{ contrat.id }}
                    </h3>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_row(form.montant, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.dateFin, {'attr': {'class': 'form-control'}}) }}
                            </div>
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.statut, {'attr': {'class': 'form-select'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.artiste, {'attr': {'class': 'form-select'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.produits) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.termes, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.documentFile, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="{{ path('contrat_show', {'id': contrat.id}) }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Enregistrer
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
