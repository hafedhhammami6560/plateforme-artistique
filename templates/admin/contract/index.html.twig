{% extends 'base.html.twig' %}

{% block title %}Gestion des Contrats - Admin - ArtConnect{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-file-text"></i> Gestion des Contrats
                </h1>
                <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Dashboard
                </a>
            </div>

            <!-- Filtres -->
            <div class="card mb-4">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-6">
                            <input type="text" name="q" class="form-control" placeholder="Rechercher par référence, artiste..." value="{{ searchQuery }}">
                        </div>
                        <div class="col-md-4">
                            <select name="status" class="form-select">
                                <option value="">Tous les statuts</option>
                                <option value="draft" {{ currentFilter == 'draft' ? 'selected' : '' }}>Brouillon</option>
                                <option value="proposed" {{ currentFilter == 'proposed' ? 'selected' : '' }}>Proposé</option>
                                <option value="signed" {{ currentFilter == 'signed' ? 'selected' : '' }}>Signé</option>
                                <option value="active" {{ currentFilter == 'active' ? 'selected' : '' }}>Actif</option>
                                <option value="terminated" {{ currentFilter == 'terminated' ? 'selected' : '' }}>Terminé</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search"></i> Filtrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Statistiques -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <h3 class="mb-0">{{ stats.total }}</h3>
                            <small>Total</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h3 class="mb-0">{{ stats.active }}</h3>
                            <small>Actifs</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <h3 class="mb-0">{{ stats.signed }}</h3>
                            <small>Signés</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-dark">
                        <div class="card-body text-center">
                            <h3 class="mb-0">{{ stats.averageCommission|number_format(1) }}%</h3>
                            <small>Commission Moyenne</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Liste des contrats -->
            <div class="card shadow-sm">
                <div class="card-body">
                    {% if contracts is empty %}
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox display-1"></i>
                            <p>Aucun contrat trouvé</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Référence</th>
                                        <th>Produit</th>
                                        <th>Artiste</th>
                                        <th>Publisher</th>
                                        <th>Commission</th>
                                        <th>Statut</th>
                                        <th>Période</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for contract in contracts %}
                                        <tr class="{{ contract.isExpired ? 'table-danger' : (contract.isExpiringSoon ? 'table-warning' : '') }}">
                                            <td><code>{{ contract.referenceNumber }}</code></td>
                                            {% set t = contract.product.title %}
                                            <td>{{ t|length > 25 ? t|slice(0, 25) ~ '...' : t }}</td>
                                            <td>{{ contract.artist.username }}</td>
                                            <td>{{ contract.publisher.username }}</td>
                                            <td><span class="badge bg-primary">{{ contract.commissionRate }}%</span></td>
                                            <td>
                                                {% if contract.status == 'draft' %}
                                                    <span class="badge bg-secondary">Brouillon</span>
                                                {% elseif contract.status == 'proposed' %}
                                                    <span class="badge bg-warning text-dark">Proposé</span>
                                                {% elseif contract.status == 'signed' %}
                                                    <span class="badge bg-info">Signé</span>
                                                {% elseif contract.status == 'active' %}
                                                    <span class="badge bg-success">Actif</span>
                                                {% else %}
                                                    <span class="badge bg-danger">Terminé</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <small>
                                                    {{ contract.startDate|date('d/m/Y') }}<br>
                                                    → {{ contract.endDate|date('d/m/Y') }}
                                                </small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="{{ path('app_admin_contract_show', {id: contract.id}) }}" class="btn btn-primary" title="Voir">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a href="{{ path('app_admin_contract_edit', {id: contract.id}) }}" class="btn btn-warning" title="Éditer">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
