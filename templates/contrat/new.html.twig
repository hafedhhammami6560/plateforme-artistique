{% extends 'base.html.twig' %}

{% block title %}Nouveau Contrat{% endblock %}

{% block body %}
<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_contrat_index') }}">Contrats</a></li>
            <li class="breadcrumb-item active">Nouveau</li>
        </ol>
    </nav>

    <h1><i class="bi bi-file-earmark-plus"></i> Créer un Nouveau Contrat</h1>

    {% if discussion is defined and discussion %}
        <div class="alert alert-info">
            <i class="bi bi-chat-dots"></i> <strong>Contrat lié à une discussion</strong>
            <ul class="mb-0 mt-2">
                <li>Discussion: <strong>{{ discussion.titre }}</strong></li>
                <li>Artiste: <strong>{{ discussion.initiateur.name }}</strong></li>
                <li>Client: <strong>{{ discussion.destinataire.name }}</strong></li>
                {% if discussion.produit %}
                    <li>Produit: <strong>{{ discussion.produit.nom }}</strong> ({{ discussion.produit.prix }}€)</li>
                {% endif %}
            </ul>
        </div>
    {% endif %}

    <div class="card mt-4">
        <div class="card-body">
            {{ form_start(form) }}
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.artiste) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.producteur) }}
                    </div>
                </div>

                {# Champs cachés quand pré-remplis depuis une discussion #}
                <div style="display: none;">
                    {{ form_row(form.type) }}
                    {% if form.produit is defined and discussion is defined and discussion %}
                        {{ form_row(form.produit) }}
                    {% endif %}
                </div>

                {# Afficher le champ produit uniquement si pas de discussion #}
                {% if form.produit is defined and (discussion is not defined or not discussion) %}
                    <div class="row mb-3">
                        <div class="col-md-12">
                            {{ form_row(form.produit, {'help': ''}) }}
                        </div>
                    </div>
                {% endif %}

                <div class="row mb-3">
                    <div class="col-md-4">
                        {{ form_row(form.prix) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.dateDebut) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.dateFin) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_row(form.conditionsTexte) }}
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_contrat_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Créer le Contrat
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
