{% extends 'base.html.twig' %}

{% block title %}Organisations{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-building"></i> Organisations</h1>
        <a href="{{ path('organisation_new') }}" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
            <i class="fas fa-plus"></i> New Organisation
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            {% if organisations|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead style="background-color: #344BE2; color: white;">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Community</th>
                            <th>Created By</th>
                            <th>Created At</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for o in organisations %}
                        <tr>
                            <td>{{ o.id }}</td>
                            <td><strong>{{ o.name }}</strong></td>
                            <td>{{ o.email ?? '-' }}</td>
                            <td>{{ o.address ?? '-' }}</td>
                            <td>
                                {% if o.communite %}
                                    <span class="badge bg-info">{{ o.communite.name }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">None</span>
                                {% endif %}
                            </td>
                            <td>{{ o.createdBy }}</td>
                            <td>{{ o.createdAt|date('Y-m-d') }}</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="{{ path('organisation_show', {'id': o.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('organisation_edit', {'id': o.id}) }}" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-building fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No organisations found. Create your first organisation!</p>
                    <a href="{{ path('organisation_new') }}" class="btn btn-primary" style="background-color: #344BE2;">
                        <i class="fas fa-plus"></i> Create Organisation
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    .btn-group .btn {
        margin: 0 2px;
    }
</style>
{% endblock %}
