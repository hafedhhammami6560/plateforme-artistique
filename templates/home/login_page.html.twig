<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login</title>
    <style>
        @import url('https://fonts.googleapis.com/css?family=Inter:400,700&display=swap');

        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Inter', sans-serif;
            background-color: #fff;
            color: #000;
        }

        .container {
            display: flex;
            height: 100vh;
            width: 100%;
            box-sizing: border-box;
            justify-content: center;
            align-items: center;
            background: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover;
            position: relative;
        }

        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: 0;
        }

        /* Left panel */
        .left-panel {
            padding: 60px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            max-width: 480px;
            box-sizing: border-box;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            position: relative;
            z-index: 1;
        }

        .left-panel h1 {
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 8px;
        }

        .left-panel p.subtitle {
            font-weight: 400;
            font-size: 0.875rem;
            margin-bottom: 40px;
            color: #222;
        }

        label {
            font-weight: 700;
            font-size: 0.75rem;
            display: block;
            margin-bottom: 4px;
        }

        input[type="text"], input[type="email"], input[type="password"] {
            width: 100%;
            height: 32px;
            padding: 6px 12px;
            font-size: 0.875rem;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            outline: none;
            margin-bottom: 20px;
            box-sizing: border-box;
            color: #000;
        }

        input[type="text"]::placeholder,
        input[type="email"]::placeholder,
        input[type="password"]::placeholder {
            color: #a0aec0;
        }

        .forgot-password {
            font-size: 0.75rem;
            text-align: right;
            margin-top: -16px;
            margin-bottom: 20px;
        }

        .forgot-password a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
        }

        .remember-container {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            font-size: 0.75rem;
            color: #4a5568;
        }

        .remember-container input[type="checkbox"] {
            margin-right: 8px;
            width: 16px;
            height: 16px;
        }

        button.login-btn {
            width: 100%;
            padding: 10px 0;
            background-color: #45621d;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            cursor: pointer;
            margin-bottom: 24px;
            transition: background-color 0.2s ease;
        }

        button.login-btn:hover {
            background-color: #364c15;
        }

        .divider {
            display: flex;
            align-items: center;
            margin: 20px 0;
            color: #a0aec0;
            font-size: 0.75rem;
        }

        .divider::before, .divider::after {
            content: "";
            flex-grow: 1;
            height: 1px;
            background: #e2e8f0;
            margin: 0 12px;
        }

        .social-buttons {
            display: flex;
            gap: 12px;
            margin-bottom: 32px;
        }

        .social-button {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: 0.75rem;
            padding: 8px 0;
            border-radius: 8px;
            cursor: pointer;
            border: 1px solid #cbd5e1;
            background-color: white;
            transition: background-color 0.2s ease;
            text-decoration: none;
            color: #000;
        }

        .social-button:hover {
            background-color: #f0f0f0;
        }

        .social-button img {
            height: 16px;
            width: 16px;
        }

        .signup-text {
            font-size: 0.75rem;
        }

        .signup-text a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
        }

        /* Right panel */
        .right-panel {
            display: none;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .left-panel {
                max-width: 100%;
                padding: 40px 20px;
                margin: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <section class="left-panel" aria-label="Login form">
            <h1>Welcome back!</h1>
            <p class="subtitle">Enter your Credentials to access your account</p>
            
            {% for message in app.flashes('success') %}
                <div style="padding: 12px 16px; background-color: #d4edda; color: #155724; border-radius: 8px; margin-bottom: 20px; border: 1px solid #c3e6cb;">
                    ✓ {{ message }}
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div style="padding: 12px 16px; background-color: #f8d7da; color: #721c24; border-radius: 8px; margin-bottom: 20px; border: 1px solid #f5c6cb;">
                    ✗ {{ message }}
                </div>
            {% endfor %}
            
            <form method="POST" action="{{ path('auth_login') }}" novalidate>
                <label for="username">Username</label>
                <input id="username" name="username" type="text" placeholder="Enter your username" required autofocus />
                
                <label for="password">Password</label>
                <input id="password" name="password" type="password" placeholder="Password" required />
                <div class="forgot-password">
                    <a href="{{ path('auth_forgot_password') }}">forgot password</a>
                </div>

                <div class="remember-container">
                    <input id="remember" name="remember" type="checkbox" />
                    <label for="remember">Remember for 30 days</label>
                </div>

                <button class="login-btn" type="submit">Login</button>
            </form>

            <div class="divider">Or</div>

            <div class="social-buttons">
                <a href="{{ path('connect_google_start') }}" class="social-button" aria-label="Sign in with Google">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg" alt="Google logo" />
                    Sign in with Google
                </a>
            </div>

            <div class="signup-text">
                Don't have an account? <a href="{{ path('auth_signup') }}">Sign Up</a>
            </div>
        </section>

        <section class="right-panel" aria-hidden="true"></section>
    </div>
</body>
</html>


