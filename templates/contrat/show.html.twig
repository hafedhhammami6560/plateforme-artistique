{% extends 'base.html.twig' %}

{% block title %}Contrat {{ contrat.numeroContrat }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_contrat_index') }}">Contrats</a></li>
            <li class="breadcrumb-item active">{{ contrat.numeroContrat }}</li>
        </ol>
    </nav>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Alerte si contrat archivé #}
    {% if contrat.isArchived %}
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-archive"></i>
            <strong>Contrat Archivé</strong> - Ce contrat a été signé par les deux parties le {{ contrat.archivedAt|date('d/m/Y à H:i') }}.
            Il ne peut plus être modifié sauf par un administrateur.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="mb-0">
                    <i class="bi bi-file-earmark-text"></i> {{ contrat.numeroContrat }}
                    {% if contrat.isArchived %}
                        <i class="bi bi-archive-fill text-primary" title="Archivé"></i>
                    {% endif %}
                </h1>
                <div>
                    {% if contrat.statut == 'signe' %}
                        <span class="badge bg-success fs-5">Signé</span>
                    {% elseif contrat.statut == 'en_attente_signature' %}
                        <span class="badge bg-warning fs-5">En attente signature</span>
                    {% elseif contrat.statut == 'final' %}
                        <span class="badge bg-primary fs-5">Final - Prêt à signer</span>
                    {% else %}
                        <span class="badge bg-secondary fs-5">Brouillon</span>
                    {% endif %}

                    {% if contrat.type == 'publication_rights' %}
                        <span class="badge bg-primary fs-5 ms-2">Publication Rights</span>
                    {% else %}
                        <span class="badge bg-success fs-5 ms-2">Custom Order</span>
                    {% endif %}
                    
                    {% if contrat.isArchived %}
                        <span class="badge bg-info fs-5 ms-2"><i class="bi bi-archive"></i> Archivé</span>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5><i class="bi bi-people"></i> Parties</h5>
                    <table class="table table-sm">
                        <tr>
                            <th>Artiste:</th>
                            <td>{{ contrat.artiste.name }}</td>
                        </tr>
                        <tr>
                            <th>Client:</th>
                            <td>{{ contrat.producteur.name }}</td>
                        </tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <h5><i class="bi bi-calendar"></i> Période</h5>
                    <table class="table table-sm">
                        <tr>
                            <th>Début:</th>
                            <td>{{ contrat.dateDebut|date('d/m/Y') }}</td>
                        </tr>
                        <tr>
                            <th>Fin:</th>
                            <td>{{ contrat.dateFin|date('d/m/Y') }}</td>
                        </tr>
                    </table>
                </div>
            </div>

            <hr>

            <div class="row">
                <div class="col-md-6">
                    <h5><i class="bi bi-currency-euro"></i> Montant</h5>
                    <p class="fs-3 text-primary"><strong>{{ contrat.prix }}€</strong></p>
                </div>
                <div class="col-md-6">
                    {% if contrat.project %}
                        <h5><i class="bi bi-box"></i> project</h5>
                        <p><strong>{{ contrat.project.nom }}</strong></p>
                        <p class="text-muted small">{{ contrat.project.description|slice(0, 100) }}...</p>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Le project sera créé après signature complète (Type B)
                        </div>
                    {% endif %}
                </div>
            </div>

            <hr>

            <h5><i class="bi bi-file-text"></i> Conditions du Contrat</h5>
            <div class="border p-3 bg-light">
                {{ contrat.conditionsTexte|nl2br }}
            </div>

            <hr>

            {# Section d'acceptation pour les brouillons #}
            {% if contrat.statut == 'brouillon' %}
                <h5><i class="bi bi-clipboard-check"></i> Acceptation des Conditions</h5>
                
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-info-circle"></i> <strong>Étape préliminaire :</strong>
                    Les deux parties doivent accepter les conditions du contrat avant de pouvoir le signer électroniquement.
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="card {% if contrat.isAcceptationArtiste %}border-success{% else %}border-secondary{% endif %}">
                            <div class="card-body">
                                <h6>
                                    <i class="bi bi-person-check"></i> Artiste: {{ contrat.artiste.name }}
                                </h6>
                                {% if contrat.isAcceptationArtiste %}
                                    <div class="alert alert-success mb-0">
                                        <i class="bi bi-check-circle-fill"></i> <strong>Conditions acceptées</strong>
                                    </div>
                                {% else %}
                                    {% set currentUserId = app.request.cookies.get('user_id')|number_format(0, '', '') %}
                                    {% set isArtist = contrat.artiste.id|number_format(0, '', '') == currentUserId %}
                                    
                                    {% if isArtist %}
                                        <p class="text-muted mb-3">
                                            <i class="bi bi-hourglass-split"></i> Veuillez accepter les conditions
                                        </p>
                                        <form method="post" action="{{ path('app_contrat_finaliser', {id: contrat.id}) }}" 
                                              onsubmit="return confirm('Confirmez-vous avoir lu et accepté toutes les conditions de ce contrat ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('finaliser_contrat_' ~ contrat.id) }}">
                                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                                <i class="bi bi-check-circle"></i> J'accepte les conditions
                                            </button>
                                        </form>
                                    {% else %}
                                        <p class="text-warning">
                                            <i class="bi bi-hourglass-split"></i> En attente d'acceptation
                                        </p>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card {% if contrat.isAcceptationClient %}border-success{% else %}border-secondary{% endif %}">
                            <div class="card-body">
                                <h6>
                                    <i class="bi bi-person-check"></i> Client: {{ contrat.producteur.name }}
                                </h6>
                                {% if contrat.isAcceptationClient %}
                                    <div class="alert alert-success mb-0">
                                        <i class="bi bi-check-circle-fill"></i> <strong>Conditions acceptées</strong>
                                    </div>
                                {% else %}
                                    {% set currentUserId = app.request.cookies.get('user_id')|number_format(0, '', '') %}
                                    {% set isClient = contrat.producteur.id|number_format(0, '', '') == currentUserId %}
                                    
                                    {% if isClient %}
                                        <p class="text-muted mb-3">
                                            <i class="bi bi-hourglass-split"></i> Veuillez accepter les conditions
                                        </p>
                                        <form method="post" action="{{ path('app_contrat_finaliser', {id: contrat.id}) }}" 
                                              onsubmit="return confirm('Confirmez-vous avoir lu et accepté toutes les conditions de ce contrat ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('finaliser_contrat_' ~ contrat.id) }}">
                                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                                <i class="bi bi-check-circle"></i> J'accepte les conditions
                                            </button>
                                        </form>
                                    {% else %}
                                        <p class="text-warning">
                                            <i class="bi bi-hourglass-split"></i> En attente d'acceptation
                                        </p>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <hr>
            {% endif %}

            <h5><i class="bi bi-pen-fill"></i> Signatures Électroniques Sécurisées</h5>
            
            {% if contrat.statut == 'brouillon' %}
                <div class="alert alert-secondary mb-3">
                    <i class="bi bi-lock"></i> <strong>Signatures verrouillées :</strong>
                    Les signatures seront disponibles une fois que les deux parties auront accepté les conditions du contrat.
                </div>
            {% else %}
                <div class="alert alert-info mb-3">
                    <i class="bi bi-shield-check"></i> <strong>Signature électronique sécurisée :</strong>
                    Chaque signature est horodatée, liée à votre adresse IP et protégée par un hash cryptographique pour garantir l'intégrité du contrat.
                </div>
            {% endif %}

            <div class="row">
                <div class="col-md-6">
                    <div class="card {% if contrat.signatureArtist %}border-success{% else %}border-warning{% endif %}">
                        <div class="card-body">
                            <h6>
                                <i class="bi bi-person-check"></i> Artiste: {{ contrat.artiste.name }}
                            </h6>
                            {% if contrat.signatureArtist %}
                                <div class="alert alert-success mb-0">
                                    <i class="bi bi-check-circle-fill"></i> <strong>Signé électroniquement</strong><br>
                                    <small>
                                        {% if contrat.dateSignatureArtist %}
                                            Le {{ contrat.dateSignatureArtist|date('d/m/Y à H:i:s') }}
                                        {% endif %}
                                    </small>
                                </div>
                            {% else %}
                                <p class="text-warning">
                                    <i class="bi bi-hourglass-split"></i> En attente de signature
                                </p>
                                {% set currentUserId = app.request.cookies.get('user_id')|number_format(0, '', '') %}
                                {% set isArtist = contrat.artiste.id|number_format(0, '', '') == currentUserId %}
                                
                                {% if isArtist and contrat.statut in ['final', 'en_attente_signature'] %}
                                    {% if contrat.artiste.hasSignature() %}
                                        <div class="alert alert-info mb-3">
                                            <small><i class="bi bi-info-circle"></i> Vérifiez votre signature avant de valider</small>
                                        </div>
                                        
                                        {# Aperçu de la signature #}
                                        <div class="card mb-3">
                                            <div class="card-header bg-light">
                                                <strong>Votre signature électronique</strong>
                                            </div>
                                            <div class="card-body text-center" style="background: #f8f9fa;">
                                                <div style="border: 2px solid #dee2e6; border-radius: 8px; padding: 20px; background: white; display: inline-block; min-width: 300px;">
                                                    <img src="{{ contrat.artiste.signatureElectronique }}" 
                                                         alt="Votre signature" 
                                                         style="max-width: 100%; height: auto; max-height: 120px;" />
                                                </div>
                                                <p class="text-muted small mt-2 mb-0">
                                                    <i class="bi bi-calendar"></i> Enregistrée le {{ contrat.artiste.signatureCreatedAt|date('d/m/Y à H:i') }}
                                                </p>
                                            </div>
                                        </div>
                                        
                                        {# Bouton de validation #}
                                        <form method="post" action="{{ path('app_signature_sign', {id: contrat.id}) }}" 
                                              onsubmit="return confirm('⚠️ ATTENTION ⚠️\n\nVous vous apprêtez à signer électroniquement ce contrat avec la signature affichée ci-dessus.\n\nCette action est irréversible et aura la même valeur juridique qu\'une signature manuscrite.\n\nConfirmez-vous vouloir signer ce contrat ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('sign_contract_' ~ contrat.id) }}">
                                            <button type="submit" class="btn btn-success btn-lg w-100">
                                                <i class="bi bi-check-circle"></i> Valider ma Signature
                                            </button>
                                        </form>
                                    {% else %}
                                        <div class="alert alert-warning mb-2">
                                            <small><i class="bi bi-exclamation-triangle"></i> Vous devez d'abord enregistrer votre signature électronique</small>
                                        </div>
                                        <a href="{{ path('app_profile_edit') }}" class="btn btn-warning btn-lg w-100">
                                            <i class="bi bi-pencil-square"></i> Enregistrer ma signature
                                        </a>
                                    {% endif %}
                                    <form method="post" action="{{ path('app_signature_request', {id: contrat.id}) }}" class="mt-2">
                                        <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                                            <i class="bi bi-envelope"></i> Relancer le client
                                        </button>
                                    </form>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card {% if contrat.signatureClient %}border-success{% else %}border-warning{% endif %}">
                        <div class="card-body">
                            <h6>
                                <i class="bi bi-person-check"></i> Client: {{ contrat.producteur.name }}
                            </h6>
                            {% if contrat.signatureClient %}
                                <div class="alert alert-success mb-0">
                                    <i class="bi bi-check-circle-fill"></i> <strong>Signé électroniquement</strong><br>
                                    <small>
                                        {% if contrat.dateSignatureClient %}
                                            Le {{ contrat.dateSignatureClient|date('d/m/Y à H:i:s') }}
                                        {% endif %}
                                    </small>
                                </div>
                            {% else %}
                                <p class="text-warning">
                                    <i class="bi bi-hourglass-split"></i> En attente de signature
                                </p>
                                {% set currentUserId = app.request.cookies.get('user_id')|number_format(0, '', '') %}
                                {% set isClient = contrat.producteur.id|number_format(0, '', '') == currentUserId %}
                                
                                {% if isClient and contrat.statut in ['final', 'en_attente_signature'] %}
                                    {% if contrat.producteur.hasSignature() %}
                                        <div class="alert alert-info mb-3">
                                            <small><i class="bi bi-info-circle"></i> Vérifiez votre signature avant de valider</small>
                                        </div>
                                        
                                        {# Aperçu de la signature #}
                                        <div class="card mb-3">
                                            <div class="card-header bg-light">
                                                <strong>Votre signature électronique</strong>
                                            </div>
                                            <div class="card-body text-center" style="background: #f8f9fa;">
                                                <div style="border: 2px solid #dee2e6; border-radius: 8px; padding: 20px; background: white; display: inline-block; min-width: 300px;">
                                                    <img src="{{ contrat.producteur.signatureElectronique }}" 
                                                         alt="Votre signature" 
                                                         style="max-width: 100%; height: auto; max-height: 120px;" />
                                                </div>
                                                <p class="text-muted small mt-2 mb-0">
                                                    <i class="bi bi-calendar"></i> Enregistrée le {{ contrat.producteur.signatureCreatedAt|date('d/m/Y à H:i') }}
                                                </p>
                                            </div>
                                        </div>
                                        
                                        {# Bouton de validation #}
                                        <form method="post" action="{{ path('app_signature_sign', {id: contrat.id}) }}" 
                                              onsubmit="return confirm('⚠️ ATTENTION ⚠️\n\nVous vous apprêtez à signer électroniquement ce contrat avec la signature affichée ci-dessus.\n\nCette action est irréversible et aura la même valeur juridique qu\'une signature manuscrite.\n\nConfirmez-vous vouloir signer ce contrat ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('sign_contract_' ~ contrat.id) }}">
                                            <button type="submit" class="btn btn-success btn-lg w-100">
                                                <i class="bi bi-check-circle"></i> Valider ma Signature
                                            </button>
                                        </form>
                                    {% else %}
                                        <div class="alert alert-warning mb-2">
                                            <small><i class="bi bi-exclamation-triangle"></i> Vous devez d'abord enregistrer votre signature électronique</small>
                                        </div>
                                        <a href="{{ path('app_profile_edit') }}" class="btn btn-warning btn-lg w-100">
                                            <i class="bi bi-pencil-square"></i> Enregistrer ma signature
                                        </a>
                                    {% endif %}
                                    <form method="post" action="{{ path('app_signature_request', {id: contrat.id}) }}" class="mt-2">
                                        <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                                            <i class="bi bi-envelope"></i> Relancer l'artiste
                                        </button>
                                    </form>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {% if contrat.statut == 'signe' %}
                <div class="alert alert-success mt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-patch-check-fill"></i> <strong>Contrat entièrement signé</strong><br>
                            <small>
                                Ce contrat a été signé électroniquement par les deux parties 
                                {% if contrat.dateSignature %}
                                    le {{ contrat.dateSignature|date('d/m/Y à H:i:s') }}
                                {% endif %}
                            </small>
                        </div>
                        <div class="btn-group">
                            <a href="{{ path('app_contrat_pdf', {id: contrat.id}) }}" class="btn btn-outline-danger" target="_blank">
                                <i class="bi bi-file-earmark-pdf"></i> Télécharger PDF
                            </a>
                            <a href="{{ path('app_signature_history', {id: contrat.id}) }}" class="btn btn-outline-success">
                                <i class="bi bi-clock-history"></i> Voir l'historique
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <a href="{{ path('app_contrat_index') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
                <div>
                    {# Modification : seulement si brouillon ET non archivé (ou admin) #}
                    {% set currentUserId = app.request.cookies.get('user_id')|number_format(0, '', '') %}
                    {% set isOwner = (contrat.artiste.id|number_format(0, '', '') == currentUserId) or (contrat.producteur.id|number_format(0, '', '') == currentUserId) %}
                    
                    {% if isOwner and contrat.statut == 'brouillon' and not contrat.isArchived %}
                        <a href="{{ path('app_contrat_edit', {id: contrat.id}) }}" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                    {% elseif contrat.isArchived %}
                        <button class="btn btn-outline-secondary" disabled title="Contrat archivé - Seul un admin peut modifier">
                            <i class="bi bi-lock"></i> Archivé
                        </button>
                    {% endif %}
                    
                    {% if contrat.isFullySigned %}
                        <a href="{{ path('app_signature_history', {id: contrat.id}) }}" class="btn btn-info">
                            <i class="bi bi-clock-history"></i> Historique
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}


