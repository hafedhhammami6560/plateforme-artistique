{% extends 'backoffice/base.html.twig' %}

{% block title %}Analytics Discussion #{{ discussion.id }} - BackOffice{% endblock %}
{% block page_title %}Analytics Discussion #{{ discussion.id }}{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="mb-3">
            <i class="bi bi-graph-up"></i> Analytics - Discussion #{{ discussion.id }}
        </h2>
        <p class="text-muted">
            <i class="bi bi-palette"></i> {{ discussion.product.title }}
        </p>
    </div>
    <div class="col-md-4 text-end">
        <a href="{{ path('app_discussion_show', {id: discussion.id}) }}" class="btn btn-primary">
            <i class="bi bi-chat-dots"></i> Voir la Discussion
        </a>
        <a href="{{ path('app_backoffice_discussion_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>
</div>

<!-- Statistiques Principales -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body text-center">
                <i class="bi bi-chat-dots display-4 text-primary"></i>
                <h3 class="mt-3">{{ analytics.total_messages }}</h3>
                <p class="text-muted mb-0">Messages Totaux</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card success">
            <div class="card-body text-center">
                <i class="bi bi-clock-history display-4 text-success"></i>
                <h3 class="mt-3">
                    {% if analytics.response_time %}
                        {{ analytics.response_time|number_format(1) }}h
                    {% else %}
                        N/A
                    {% endif %}
                </h3>
                <p class="text-muted mb-0">Temps de Réponse Moyen</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card warning">
            <div class="card-body text-center">
                <i class="bi bi-file-text display-4 text-warning"></i>
                <h3 class="mt-3">{{ analytics.contract_proposals }}</h3>
                <p class="text-muted mb-0">Propositions Contrat</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body text-center">
                <i class="bi bi-calendar-check display-4 text-info"></i>
                <h3 class="mt-3">{{ analytics.activity_by_day|length }}</h3>
                <p class="text-muted mb-0">Jours d'Activité</p>
            </div>
        </div>
    </div>
</div>

<!-- Engagement des Participants -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-people"></i> Engagement des Participants
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>
                            <i class="bi bi-person"></i> {{ discussion.artist.fullName }} (Artiste)
                        </span>
                        <strong>{{ analytics.participant_engagement.artist }} messages</strong>
                    </div>
                    <div class="progress" style="height: 25px;">
                        <div class="progress-bar bg-primary" role="progressbar" 
                             style="width: {{ (analytics.participant_engagement.artist / analytics.total_messages * 100)|number_format }}%">
                            {{ (analytics.participant_engagement.artist / analytics.total_messages * 100)|number_format }}%
                        </div>
                    </div>
                </div>
                
                <div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>
                            <i class="bi bi-building"></i> {{ discussion.publisher.fullName }} (Publisher)
                        </span>
                        <strong>{{ analytics.participant_engagement.publisher }} messages</strong>
                    </div>
                    <div class="progress" style="height: 25px;">
                        <div class="progress-bar bg-success" role="progressbar" 
                             style="width: {{ (analytics.participant_engagement.publisher / analytics.total_messages * 100)|number_format }}%">
                            {{ (analytics.participant_engagement.publisher / analytics.total_messages * 100)|number_format }}%
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle"></i> Informations Discussion
                </h5>
            </div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tr>
                        <th width="40%">Statut:</th>
                        <td>
                            {% if discussion.status == 'active' %}
                                <span class="badge bg-success">Active</span>
                            {% elseif discussion.status == 'pending' %}
                                <span class="badge bg-warning text-dark">En attente</span>
                            {% elseif discussion.status == 'closed' %}
                                <span class="badge bg-secondary">Fermée</span>
                            {% else %}
                                <span class="badge bg-dark">{{ discussion.statusLabel }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Créée le:</th>
                        <td>{{ discussion.createdAt|date('d/m/Y à H:i') }}</td>
                    </tr>
                    <tr>
                        <th>Dernière activité:</th>
                        <td>{{ discussion.updatedAt ? discussion.updatedAt|date('d/m/Y à H:i') : 'N/A' }}</td>
                    </tr>
                    <tr>
                        <th>Contrat:</th>
                        <td>
                            {% if discussion.hasContract %}
                                <a href="{{ path('app_contract_show', {id: discussion.contract.id}) }}" class="btn btn-sm btn-success">
                                    <i class="bi bi-check-circle"></i> Voir le Contrat
                                </a>
                            {% else %}
                                <span class="text-muted">Aucun contrat</span>
                            {% endif %}
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Activité par Jour -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-calendar3"></i> Activité par Jour
                </h5>
            </div>
            <div class="card-body">
                {% if analytics.activity_by_day is empty %}
                    <p class="text-muted text-center py-4">Aucune données d'activité disponible</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Messages</th>
                                    <th width="60%">Activité</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for date, count in analytics.activity_by_day %}
                                    <tr>
                                        <td>{{ date|date('d/m/Y') }}</td>
                                        <td><strong>{{ count }}</strong></td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-info" role="progressbar" 
                                                     style="width: {{ (count / max(analytics.activity_by_day) * 100)|number_format }}%">
                                                    {{ count }} message{{ count > 1 ? 's' : '' }}
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
