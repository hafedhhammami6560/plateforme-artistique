{% extends 'base.html.twig' %}

{% block title %}Détails du Contrat{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1><i class="fas fa-file-contract"></i> Contrat {{ contrat.numeroContrat }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Numéro de Contrat</th>
                <td><strong>{{ contrat.numeroContrat }}</strong></td>
            </tr>
            <tr>
                <th>Montant</th>
                <td>{{ contrat.montant }} €</td>
            </tr>
            <tr>
                <th>Date début</th>
                <td>{{ contrat.dateDebut ? contrat.dateDebut|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date fin</th>
                <td>{{ contrat.dateFin ? contrat.dateFin|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ contrat.statut }}</td>
            </tr>
            <tr>
                <th>Termes</th>
                <td>{{ contrat.termes }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_contrat_index') }}" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Retour à la liste</a>
    <a href="{{ path('app_contrat_edit', {'id': contrat.id}) }}" class="btn btn-warning"><i class="fas fa-edit"></i> Modifier</a>
</div>
{% endblock %}
