{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Statistiques{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">
        <i class="fas fa-chart-bar"></i> Tableau de bord - Statistiques
    </h1>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-users"></i> Utilisateurs</h5>
                    <h2 class="card-text">{{ totalUsers }}</h2>
                    <p class="card-text">
                        <small>Admins: {{ totalAdmins }} | Vérifiés: {{ totalVerified }}</small>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-file-contract"></i> Contrats</h5>
                    <h2 class="card-text">{{ totalContrats }}</h2>
                    <a href="{{ path('app_contrat_index') }}" class="btn btn-light btn-sm mt-2">Voir tous</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-comment-dots"></i> Discussions</h5>
                    <h2 class="card-text">{{ totalDiscussions }}</h2>
                    <a href="{{ path('app_discussion_index') }}" class="btn btn-light btn-sm mt-2">Voir toutes</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-box"></i> Projects</h5>
                    <h2 class="card-text">{{ totalProjectss }}</h2>
                    <a href="{{ path('project_index') }}" class="btn btn-light btn-sm mt-2">Voir tous les Projects</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Vue d'ensemble</h5>
                </div>
                <div class="card-body">
                    <p>Bienvenue sur le tableau de bord des statistiques de la plateforme artistique.</p>
                    <p>Vous pouvez voir ici un aperçu rapide de l'activité sur la plateforme.</p>
                    
                    <hr>
                    
                    <div class="row text-center">
                        <div class="col-md-3">
                            <a href="{{ path('app_contrat_index') }}" class="btn btn-outline-success btn-block">
                                <i class="fas fa-file-contract"></i> Voir Contrats
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="{{ path('app_discussion_new') }}" class="btn btn-outline-info btn-block">
                                <i class="fas fa-plus"></i> Nouvelle Discussion
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="{{ path('communite_index') }}" class="btn btn-outline-primary btn-block">
                                <i class="fas fa-users"></i> Communautés
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="{{ path('organisation_index') }}" class="btn btn-outline-warning btn-block">
                                <i class="fas fa-building"></i> Organisations
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}


