{% extends 'base.html.twig' %}

{% block title %}Nouvelle Discussion{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4"><i class="bi bi-plus-circle"></i> Nouvelle Discussion</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 col-md-10 col-12">
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="card shadow-sm">
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                        {# Champ type caché mais toujours présent dans le formulaire #}
                        <div style="display: none;">
                            {{ form_row(form.type) }}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">{{ form_label(form.titre) }}</label>
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Acquisition droits album ou Commande sculpture'}}) }}
                            {{ form_errors(form.titre) }}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">{{ form_label(form.destinataire) }}</label>
                            {{ form_widget(form.destinataire, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.destinataire) }}
                        </div>

                        <div class="mb-3" id="produit-field" style="display: none;">
                            {% if form.produit is defined %}
                                <label class="form-label fw-bold">Produit concerné</label>
                                {{ form_widget(form.produit, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.produit) }}
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">{{ form_label(form.messageInitial) }}</label>
                            {{ form_widget(form.messageInitial, {'attr': {'class': 'form-control', 'rows': '5', 'placeholder': 'Décrivez votre demande...'}}) }}
                            {{ form_errors(form.messageInitial) }}
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('app_discussion_index') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Créer la Discussion
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const typeInputs = document.querySelectorAll('input[name="discussion[type]"]');
    const produitField = document.getElementById('produit-field');
    
    function updateProduitVisibility() {
        const selectedType = document.querySelector('input[name="discussion[type]"]:checked');
        if (selectedType && selectedType.value === 'publication_rights') {
            produitField.style.display = 'block';
        } else {
            produitField.style.display = 'none';
        }
    }
    
    typeInputs.forEach(input => {
        input.addEventListener('change', updateProduitVisibility);
    });
    
    updateProduitVisibility();
});
</script>
{% endblock %}
