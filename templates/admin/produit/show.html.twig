{% extends 'base.html.twig' %}
{% block title %}{{ projet.nom }} - Admin{% endblock %}
{% block body %}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">{{ projet.nom }}</h1>
    <div>
      <a class="btn btn-warning" href="{{ path('admin_projet_edit', {id:projet.id}) }}">Modifier</a>
      <a class="btn btn-secondary" href="{{ path('admin_projet_index') }}">Retour</a>
    </div>
  </div>
  <div class="card"><div class="card-body">
    {% if projet.image %}
      <div class="mb-3 text-center"><img src="{{ asset('uploads/projets/' ~ projet.image) }}" class="img-fluid" alt="{{ projet.nom }}" style="max-height: 320px; object-fit: cover"></div>
    {% endif %}
    <table class="table">
      <tbody>
        <tr><th>ID</th><td>{{ projet.id }}</td></tr>
        <tr><th>Nom</th><td>{{ projet.nom }}</td></tr>
        <tr><th>Description</th><td>{{ projet.description ?: '-' }}</td></tr>
        <tr><th>Catégorie</th><td>{{ projet.categorie ? projet.categorie.nom : (projet.categorieLabel ?: '-') }}</td></tr>
        <tr><th>Prix</th><td>{{ projet.prix }} €</td></tr>
        <tr><th>Créé le</th><td>{{ projet.dateCreation ? projet.dateCreation|date('d/m/Y') : '-' }}</td></tr>
      </tbody>
    </table>
  </div></div>
</div>
{% endblock %}
