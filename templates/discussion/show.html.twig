{% extends 'base.html.twig' %}

{% block title %}Détails de la Discussion{% endblock %}

{% block body %}
<div class="container">
    <h1>{{ discussion.titre }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ discussion.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ discussion.titre }}</td>
            </tr>
            <tr>
                <th>Sujet</th>
                <td>{{ discussion.sujet }}</td>
            </tr>
            <tr>
                <th>Contenu</th>
                <td>{{ discussion.contenu }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ discussion.statut }}</td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>{{ discussion.createdAt ? discussion.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('discussion_index') }}" class="btn btn-secondary">Retour à la liste</a>
</div>
{% endblock %}
