{% extends 'base.html.twig' %}
{% block title %}Nouvelle catégorie - Admin{% endblock %}
{% block body %}
<div class="container mt-4">
  <h1 class="h3">Nouvelle catégorie</h1>
  <div class="card"><div class="card-body">
    {{ form_start(form) }}
      <div class="mb-3">{{ form_row(form.nom) }}</div>
      <div class="mb-3">{{ form_row(form.description) }}</div>
      <div class="d-flex justify-content-between">
        <a href="{{ path('admin_categorie_index') }}" class="btn btn-secondary">Retour</a>
        <button class="btn btn-primary">Enregistrer</button>
      </div>
    {{ form_end(form) }}
  </div></div>
</div>
{% endblock %}


