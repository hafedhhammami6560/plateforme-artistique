
{{ form_start(form) }}
    <div>
        {{ form_row(form.name) }}
    </div>
    <div>
        {{ form_row(form.type) }}
    </div>
    {# Champs Adresse et E-mail supprimés #}
    <div>
        {{ form_row(form.addressGoogle) }}
        <label for="gmaps-autocomplete">Recherche d'adresse Google Maps :</label>
        <input id="gmaps-autocomplete" type="text" placeholder="Rechercher une adresse Google Maps" style="width:100%;margin-bottom:10px;" />
        <div id="gmaps-map" style="width:100%;height:300px;margin-bottom:10px;"></div>
        <input type="hidden" id="organisation_latitude" name="organisation[latitude]" value="{{ form.latitude.vars.value }}" />
        <input type="hidden" id="organisation_longitude" name="organisation[longitude]" value="{{ form.longitude.vars.value }}" />
    </div>
    <div>
        {{ form_row(form.communite) }}
    </div>
    <button type="submit">Enregistrer</button>
{{ form_end(form) }}

{# Google Maps JS API #}
<script src="https://maps.googleapis.com/maps/api/js?key=YOUR_REAL_API_KEY&libraries=places"></script>
<script>
let map, marker, autocomplete;
function initMap() {
    try {
        map = new google.maps.Map(document.getElementById('gmaps-map'), {
            center: { lat: 48.8566, lng: 2.3522 },
            zoom: 12
        });
        marker = new google.maps.Marker({ map });
        autocomplete = new google.maps.places.Autocomplete(document.getElementById('gmaps-autocomplete'));
        autocomplete.addListener('place_changed', function() {
            const place = autocomplete.getPlace();
            if (!place.geometry) return;
            map.setCenter(place.geometry.location);
            marker.setPosition(place.geometry.location);
            document.getElementById('organisation_addressGoogle').value = place.formatted_address;
            document.getElementById('organisation_latitude').value = place.geometry.location.lat();
            document.getElementById('organisation_longitude').value = place.geometry.location.lng();
        });
    } catch (e) {
        document.getElementById('gmaps-map').innerHTML = '<div style="color:red;text-align:center;padding:20px;">Erreur Google Maps : ' + e.message + '</div>';
    }
}
window.addEventListener('DOMContentLoaded', initMap);
</script>
