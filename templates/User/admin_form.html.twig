{% extends 'base.html.twig' %}

{% block title %}{{ action }} User{% endblock %}

{% block body %}
    <style>
        body {
            font-family: 'Poppins', Arial, sans-serif;
            margin: 0;
            background: linear-gradient(135deg, #344BE2 0%, #c1d5f3 100%);
            min-height: 100vh;
        }
        .form-card {
            background: #fff;
            max-width: 420px;
            margin: 48px auto 0 auto;
            border-radius: 18px;
            box-shadow: 0 8px 32px rgba(52,75,226,0.12);
            padding: 38px 32px 32px 32px;
        }
        .form-title {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 32px;
        }
        .form-title svg {
            width: 32px;
            height: 32px;
            stroke: #344BE2;
            fill: none;
        }
        .form-title h1 {
            color: #344BE2;
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
        }
        .form-group {
            margin-bottom: 22px;
        }
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #344BE2;
            font-size: 15px;
        }
        input[type="text"],
        input[type="email"],
        input[type="password"],
        select {
            width: 100%;
            padding: 12px;
            border: 1px solid #c1d5f3;
            border-radius: 8px;
            font-size: 15px;
            color: #344BE2;
            background-color: #f4f7fb;
            transition: border 0.2s;
        }
        input:focus,
        select:focus {
            outline: none;
            border-color: #344BE2;
            box-shadow: 0 0 0 2px rgba(52,75,226,0.08);
        }
        .btn {
            padding: 12px 28px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-size: 15px;
            font-weight: 600;
            margin-right: 10px;
            transition: background 0.2s, color 0.2s, box-shadow 0.2s;
        }
        .btn-primary {
            background-color: #344BE2;
            color: #fff;
            box-shadow: 0 2px 8px rgba(52,75,226,0.08);
        }
        .btn-primary:hover {
            background-color: #2a3db8;
        }
        .btn-secondary {
            background-color: #6c757d;
            color: #fff;
        }
        .btn-secondary:hover {
            background-color: #5a6268;
        }
        .form-actions {
            margin-top: 32px;
            display: flex;
            gap: 10px;
        }
        .help-text {
            font-size: 12px;
            color: #6c757d;
            margin-top: 5px;
        }
    </style>

    <div class="form-card">
        <div class="form-title">
            <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="14"/><path d="M16 10v8m0 4h.01"/></svg>
            <h1>{{ action }} User</h1>
        </div>
        <form method="POST">
            <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" value="{{ user ? user.name : '' }}" required>
            </div>
            <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" value="{{ user ? user.email : '' }}" required>
            </div>
            <div class="form-group">
                <label for="password">Password {{ user ? '' : '*' }}</label>
                <input type="password" id="password" name="password" {{ user ? '' : 'required' }}>
                {% if user %}
                    <div class="help-text">Leave blank to keep current password</div>
                {% endif %}
            </div>
            <div class="form-group">
                <label for="role">Role *</label>
                <select id="role" name="role" required>
                    <option value="ROLE_USER" {{ (user and user.roles[0] == 'ROLE_USER') or not user ? 'selected' : '' }}>User</option>
                    <option value="ROLE_ADMIN" {{ user and user.roles[0] == 'ROLE_ADMIN' ? 'selected' : '' }}>Admin</option>
                </select>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">{{ action }} User</button>
                <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
{% endblock %}
