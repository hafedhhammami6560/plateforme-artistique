{% extends 'base.html.twig' %}

{% block title %}{{ projet.nom }}{% endblock %}

{% block body %}
<div class="container">
        <h1>{{ projet.nom }}</h1>
        {% if projet.image %}
            <div class="mb-3"><img src="{{ asset('uploads/projets/' ~ projet.image) }}" alt="{{ projet.nom }}" class="img-fluid" style="max-height: 360px; object-fit: cover"></div>
        {% endif %}

    <table class="table">
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ projet.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ projet.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ projet.description }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ projet.prix }} €</td>
            </tr>
            <tr>
                <th>Catégorie</th>
                <td>{{ projet.categorie ? projet.categorie.nom : (projet.categorieLabel ?: '-') }}</td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>{{ projet.dateCreation ? projet.dateCreation|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('projet_index') }}" class="btn btn-secondary">Retour à la liste</a>
</div>
{% endblock %}
