{% extends 'base.html.twig' %}

{% block title %}New Community{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header" style="background-color: #344BE2; color: white;">
                    <h4 class="mb-0"><i class="fas fa-users"></i> Create New Community</h4>
                </div>
                <div class="card-body p-4">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.name, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.name) }}
                            {{ form_errors(form.name) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.slug, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.slug) }}
                            {{ form_errors(form.slug) }}
                            <small class="form-text text-muted">URL-friendly identifier (e.g., "artist-community")</small>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.description) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                {{ form_label(form.type, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.type) }}
                                {{ form_errors(form.type) }}
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">&nbsp;</label>
                                <div class="form-check">
                                    {{ form_widget(form.isPrivate) }}
                                    {{ form_label(form.isPrivate) }}
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_community_index') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
                                <i class="fas fa-save"></i> Create Community
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
