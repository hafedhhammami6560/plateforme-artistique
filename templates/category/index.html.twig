{% extends 'base.html.twig' %}

{% block title %}Catégories - ArtConnect{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-folder"></i> Catégories</h1>
        <a href="{{ path('app_category_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouvelle catégorie
        </a>
    </div>

    {% if categories %}
        <div class="row g-4">
            {% for category in categories %}
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{ category.name }}</h5>
                            {% if category.description %}
                                <p class="card-text">{{ category.description|slice(0, 100) }}{{ category.description|length > 100 ? '...' : '' }}</p>
                            {% endif %}
                            <p class="text-muted small">
                                <i class="fas fa-project-diagram"></i> {{ category.projects|length }} projet(s)
                            </p>
                            <div class="d-flex gap-2">
                                <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Éditer
                                </a>
                                <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Êtes-vous sûr?')">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Aucune catégorie trouvée.
            <a href="{{ path('app_category_new') }}" class="alert-link">Créer la première</a>
        </div>
    {% endif %}
</div>
{% endblock %}
