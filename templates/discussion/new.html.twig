{% extends 'base.html.twig' %}

{% block title %}Nouvelle Discussion - ArtConnect{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle"></i> Créer une Nouvelle Discussion
                    </h4>
                </div>
                <div class="card-body">
                    {# Global form errors #}
                    {% if form_errors(form) %}
                        <div class="alert alert-danger">
                            {{ form_errors(form) }}
                        </div>
                    {% endif %}
                    <p class="text-muted">
                        Initiez une discussion avec un artiste concernant une œuvre qui vous intéresse.
                    </p>

                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                        {% if form.artist is defined %}
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Choisissez un artiste</label>
                            {{ form_widget(form.artist) }}
                            <div class="text-danger small">{{ form_errors(form.artist) }}</div>
                        </div>
                        {% endif %}
                        <div class="mb-3">
                            {{ form_label(form.product, 'Sélectionnez l\'œuvre qui vous intéresse') }}
                            {{ form_widget(form.product, { attr: { size: 8, style: 'max-height: 220px; overflow:auto;' } }) }}
                            <div class="text-danger small">{{ form_errors(form.product) }}</div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.subject, 'Sujet de la discussion (optionnel)') }}
                            {{ form_widget(form.subject) }}
                            <div class="text-danger small">{{ form_errors(form.subject) }}</div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.initialMessage, 'Votre message initial') }}
                            {{ form_widget(form.initialMessage) }}
                            <div class="text-danger small">{{ form_errors(form.initialMessage) }}</div>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_discussion_index') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send"></i> Créer la Discussion
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>

            <!-- Information Box -->
            <div class="alert alert-info mt-4" role="alert">
                <h5 class="alert-heading"><i class="bi bi-info-circle"></i> Information</h5>
                <p class="mb-0">
                    Lorsque vous créez une discussion, l'artiste propriétaire de l'œuvre sera automatiquement notifié
                    et pourra répondre à votre message. Vous pourrez ensuite négocier les termes et créer un contrat si un accord est trouvé.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
