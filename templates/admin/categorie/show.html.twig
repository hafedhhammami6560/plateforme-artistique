{% extends 'base.html.twig' %}
{% block title %}{{ categorie.nom }} - Admin{% endblock %}
{% block body %}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">{{ categorie.nom }}</h1>
    <div>
      <a class="btn btn-warning" href="{{ path('admin_categorie_edit', {id:categorie.id}) }}">Modifier</a>
      <a class="btn btn-secondary" href="{{ path('admin_categorie_index') }}">Retour</a>
    </div>
  </div>
  <div class="card"><div class="card-body">
    <table class="table">
      <tbody>
        <tr><th>ID</th><td>{{ categorie.id }}</td></tr>
        <tr><th>Nom</th><td>{{ categorie.nom }}</td></tr>
        <tr><th>Description</th><td>{{ categorie.description ?: '-' }}</td></tr>
      </tbody>
    </table>
    {% if categorie.produits|length %}
      <h5 class="mt-4">Produits</h5>
      <ul class="list-group">
        {% for p in categorie.produits %}
          <li class="list-group-item d-flex justify-content-between align-items-center">
            {{ p.nom }}
            <a class="btn btn-sm btn-info" href="{{ path('produit_show', {id:p.id}) }}">Voir</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div></div>
</div>
{% endblock %}
