{% extends 'base.html.twig' %}

{% block title %}Nouveau Feedback{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header" style="background-color: #344BE2; color: white;">
                    <h3 class="mb-0"><i class="fas fa-plus"></i> Nouveau Feedback</h3>
                </div>
                <div class="card-body p-4">
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle"></i> {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_row(form.authorName) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.type) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.targetType) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.rating) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.content) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.communite) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.organisation) }}
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('feedback_index') }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
                                <i class="fas fa-save"></i> Créer
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
