{% extends 'base.html.twig' %}

{% block title %}Mes Discussions{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-chat-dots"></i> Mes Discussions</h1>
        <a href="{{ path('app_discussion_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nouvelle Discussion
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Barre de recherche et filtres #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('app_discussion_index') }}" class="row g-3">
                <div class="col-md-4">
                    <label for="search" class="form-label">Rechercher</label>
                    <input type="text" class="form-control" id="search" name="search" 
                           value="{{ search }}" placeholder="Titre, utilisateur, produit...">
                </div>
                
                <div class="col-md-2">
                    <label for="type" class="form-label">Type</label>
                    <select class="form-select" id="type" name="type">
                        <option value="">Tous</option>
                        <option value="publication_rights" {% if typeFilter == 'publication_rights' %}selected{% endif %}>Publication Rights</option>
                        <option value="custom_order" {% if typeFilter == 'custom_order' %}selected{% endif %}>Custom Order</option>
                    </select>
                </div>
                
                <div class="col-md-2">
                    <label for="statut" class="form-label">Statut</label>
                    <select class="form-select" id="statut" name="statut">
                        <option value="">Tous</option>
                        <option value="en_cours" {% if statutFilter == 'en_cours' %}selected{% endif %}>En cours</option>
                        <option value="terminee" {% if statutFilter == 'terminee' %}selected{% endif %}>Terminée</option>
                    </select>
                </div>
                
                <div class="col-md-2">
                    <label for="sort" class="form-label">Trier par</label>
                    <select class="form-select" id="sort" name="sort">
                        <option value="date_desc" {% if sortBy == 'date_desc' %}selected{% endif %}>Date (récent)</option>
                        <option value="date_asc" {% if sortBy == 'date_asc' %}selected{% endif %}>Date (ancien)</option>
                        <option value="titre_asc" {% if sortBy == 'titre_asc' %}selected{% endif %}>Titre (A-Z)</option>
                        <option value="titre_desc" {% if sortBy == 'titre_desc' %}selected{% endif %}>Titre (Z-A)</option>
                    </select>
                </div>
                
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Filtrer
                    </button>
                    <a href="{{ path('app_discussion_index') }}" class="btn btn-outline-secondary" title="Réinitialiser les filtres">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    {% if discussions is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Aucune discussion trouvée.
            {% if search or typeFilter or statutFilter %}
                <a href="{{ path('app_discussion_index') }}">Réinitialiser les filtres</a>
            {% else %}
                <a href="{{ path('app_discussion_new') }}">Créer une discussion</a>
            {% endif %}
        </div>
    {% else %}
        <div class="mb-3">
            <strong>{{ discussions|length }}</strong> discussion(s) trouvée(s)
        </div>
        <div class="list-group">
            {% for discussion in discussions %}
                <a href="{{ path('app_discussion_show', {id: discussion.id}) }}" 
                   class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">
                            {% if discussion.type == 'publication_rights' %}
                                <span class="badge bg-primary">Publication Rights</span>
                            {% else %}
                                <span class="badge bg-success">Custom Order</span>
                            {% endif %}
                            {{ discussion.titre }}
                        </h5>
                        <small>{{ discussion.createdAt|date('d/m/Y H:i') }}</small>
                    </div>
                    <p class="mb-1">
                        <strong>Avec:</strong>
                        {% if currentUser.id == discussion.initiateur.id %}
                            {{ discussion.destinataire.name }}
                        {% else %}
                            {{ discussion.initiateur.name }}
                        {% endif %}
                    </p>
                    {% if discussion.produit %}
                        <p class="mb-1">
                            <strong>Produit:</strong> {{ discussion.produit.nom }}
                        </p>
                    {% endif %}
                    <small>
                        {% if discussion.statut == 'en_cours' %}
                            <span class="badge bg-success">En cours</span>
                        {% else %}
                            <span class="badge bg-secondary">Terminée</span>
                        {% endif %}
                        
                        {% if discussion.contrat %}
                            <span class="badge bg-info">Contrat lié</span>
                        {% endif %}
                        
                        <span class="badge bg-light text-dark">
                            {{ discussion.messages|length }} message{{ discussion.messages|length > 1 ? 's' : '' }}
                        </span>
                    </small>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
