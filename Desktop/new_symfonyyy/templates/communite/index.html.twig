{% extends 'base.html.twig' %}

{% block title %}Communautés{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-users"></i> Communautés</h1>
        <a href="{{ path('communite_new') }}" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
            <i class="fas fa-plus"></i> Nouvelle Communauté
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <!-- Filtres et recherche -->
    <div class="card shadow-sm mb-3">
        <div class="card-header" style="background-color: #f8f9fa;">
            <h5 class="mb-0"><i class="fas fa-filter"></i> Recherche & Tri</h5>
        </div>
        <div class="card-body">
            <form method="get" action="{{ path('communite_index') }}" class="row g-3">
                <div class="col-md-6">
                    <label for="search" class="form-label"><i class="fas fa-search"></i> Rechercher</label>
                    <input type="text" class="form-control" id="search" name="search" value="{{ search }}" placeholder="Nom ou description...">
                </div>
                <div class="col-md-3">
                    <label for="sort" class="form-label"><i class="fas fa-sort"></i> Trier par</label>
                    <select class="form-control" id="sort" name="sort">
                        <option value="name" {% if sortBy == 'name' %}selected{% endif %}>Nom</option>
                        <option value="description" {% if sortBy == 'description' %}selected{% endif %}>Description</option>
                        <option value="createdBy" {% if sortBy == 'createdBy' %}selected{% endif %}>Créé par</option>
                        <option value="createdAt" {% if sortBy == 'createdAt' %}selected{% endif %}>Date de création</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="order" class="form-label">Ordre</label>
                    <select class="form-control" id="order" name="order">
                        <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>↑ Croissant</option>
                        <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>↓ Décroissant</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
                        <i class="fas fa-search"></i> Appliquer
                    </button>
                    <a href="{{ path('communite_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-redo"></i> Réinitialiser
                    </a>
                    <span class="text-muted ms-3">
                        <i class="fas fa-info-circle"></i> {{ communites|length }} résultat(s)
                    </span>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            {% if communites|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead style="background-color: #344BE2; color: white;">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Organisations</th>
                            <th>Créé par</th>
                            <th>Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for c in communites %}
                        <tr>
                            <td>{{ c.id }}</td>
                            <td><strong>{{ c.name }}</strong></td>
                            <td>{{ c.description|default('-')|slice(0, 50) }}{% if c.description|length > 50 %}...{% endif %}</td>
                            <td><span class="badge bg-info">{{ c.organisations|length }}</span></td>
                            <td>{{ c.createdBy }}</td>
                            <td>{{ c.createdAt|date('Y-m-d') }}</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="{{ path('communite_show', {'id': c.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('communite_edit', {'id': c.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="{{ path('communite_delete', {'id': c.id}) }}" style="display: inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette communauté ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Aucune communauté trouvée.</p>
                    <a href="{{ path('communite_new') }}" class="btn btn-primary" style="background-color: #344BE2;">
                        <i class="fas fa-plus"></i> Créer une communauté
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    .btn-group .btn {
        margin: 0 2px;
    }
</style>
{% endblock %}
