{% extends 'base.html.twig' %}

{% block title %}Liste des Discussions{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">
                    <i class="fas fa-comments text-primary"></i> Gestion des Discussions
                </h1>
                <a href="{{ path('app_discussion_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nouvelle Discussion
                </a>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Titre</th>
                <th>Sujet</th>
                <th>Initiateur</th>
                <th>Destinataire</th>
                <th>Statut</th>
                <th>Date création</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for discussion in discussions %}
            <tr>
                <td>{{ discussion.id }}</td>
                <td>{{ discussion.titre }}</td>
                <td>{{ discussion.sujet }}</td>
                <td>{{ discussion.initiateur ? discussion.initiateur.name : 'N/A' }}</td>
                <td>{{ discussion.destinataire ? discussion.destinataire.name : 'N/A' }}</td>
                <td>
                    {% if discussion.statut == 'OUVERTE' %}
                        <span class="badge bg-success">Ouverte</span>
                    {% else %}
                        <span class="badge bg-secondary">Fermée</span>
                    {% endif %}
                </td>
                <td>{{ discussion.createdAt ? discussion.createdAt|date('d/m/Y H:i') : '' }}</td>
                <td>
                    <a href="{{ path('app_discussion_show', {'id': discussion.id}) }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('app_discussion_edit', {'id': discussion.id}) }}" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8" class="text-center text-muted py-5">
                    <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                    <p>Aucune discussion trouvée</p>
                    <a href="{{ path('app_discussion_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Créer votre première discussion
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
