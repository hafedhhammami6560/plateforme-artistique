APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share

DEFAULT_URI=http://localhost

# Using XAMPP's MySQL/MariaDB (adjust user/password if you changed defaults)
# Database name set to 'Artconnect'  change if you prefer another name.
DATABASE_URL="mysql://root:@127.0.0.1:3306/Artconnect?serverVersion=mariadb-10.4.32&charset=utf8mb4"

###> Google OAuth ###
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
###< Google OAuth ###
###> symfony/mailer ###
# Mailtrap API Token and Inbox ID (get from https://mailtrap.io/inboxes)
MAILTRAP_API_TOKEN=9f1e568fad6c6ab746c317f8c55ad3fc
MAILTRAP_INBOX_ID=4232290
# Option 1 - Mailtrap (Testing - Free): Get credentials from https://mailtrap.io
# MAILER_DSN=smtp://YOUR_MAILTRAP_USERNAME:YOUR_MAILTRAP_PASSWORD@smtp.mailtrap.io:2525

# Option 2 - Gmail (Real emails): Use App Password from Google Account settings
# MAILER_DSN=gmail://your-email@gmail.com:your-app-password@default

# Option 3 - Brevo/Sendinblue (Free - 300 emails/day): Get API key from https://www.brevo.com
# MAILER_DSN=smtp://YOUR_SMTP_LOGIN:YOUR_SMTP_KEY@smtp-relay.brevo.com:587

# Current (using Mailtrap API instead of SMTP):
MAILER_DSN=null://null
###< symfony/mailer ###
