{% extends 'base.html.twig' %}

{% block title %}Modifier la Discussion{% endblock %}

{% block body %}
<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_discussion_index') }}">Discussions</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_discussion_show', {id: discussion.id}) }}">Discussion #{{ discussion.id }}</a></li>
            <li class="breadcrumb-item active">Modifier</li>
        </ol>
    </nav>

    <h1><i class="bi bi-pencil"></i> Modifier la Discussion</h1>

    <div class="alert alert-info mt-4">
        <i class="bi bi-info-circle"></i> <strong>Note:</strong> Seul l'initiateur de la discussion peut la modifier, et uniquement si elle n'est pas terminée.
    </div>

    <div class="card mt-4">
        <div class="card-body">
            {{ form_start(form) }}
                
                {{ form_row(form.type) }}
                
                {% if form.projet is defined %}
                    <div id="projet-field">
                        {{ form_row(form.projet) }}
                    </div>
                {% endif %}

                <div class="alert alert-warning">
                    <h5><i class="bi bi-exclamation-triangle"></i> Rappel</h5>
                    <ul class="mb-0">
                        <li><strong>Type A (Publication Rights):</strong> Nécessite un projet existant</li>
                        <li><strong>Type B (Custom Order):</strong> Pour une commande personnalisée</li>
                    </ul>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_discussion_show', {id: discussion.id}) }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Enregistrer les Modifications
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const typeRadios = document.querySelectorAll('input[name="discussion[type]"]');
        const projetField = document.getElementById('projet-field');
        
        if (typeRadios.length && projetField) {
            function toggleprojetField() {
                const selectedType = document.querySelector('input[name="discussion[type]"]:checked');
                if (selectedType) {
                    projetField.style.display = selectedType.value === 'publication_rights' ? 'block' : 'none';
                }
            }
            
            typeRadios.forEach(radio => {
                radio.addEventListener('change', toggleprojetField);
            });
            
            toggleprojetField();
        }
    });
</script>
{% endblock %}
