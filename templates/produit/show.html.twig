{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }}{% endblock %}

{% block body %}
<div class="container">
        <h1>{{ produit.nom }}</h1>
        {% if produit.image %}
            <div class="mb-3"><img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}" class="img-fluid" style="max-height: 360px; object-fit: cover"></div>
        {% endif %}

    <table class="table">
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ produit.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ produit.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ produit.description }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ produit.prix }} €</td>
            </tr>
            <tr>
                <th>Catégorie</th>
                <td>{{ produit.categorie ? produit.categorie.nom : (produit.categorieLabel ?: '-') }}</td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>{{ produit.dateCreation ? produit.dateCreation|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('produit_index') }}" class="btn btn-secondary">Retour à la liste</a>
</div>
{% endblock %}
