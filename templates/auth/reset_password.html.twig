<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Réinitialiser le mot de passe</title>
    <style>
        @import url('https://fonts.googleapis.com/css?family=Inter:400,700&display=swap');

        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Inter', sans-serif;
            background-color: #fff;
            color: #000;
        }

        .container {
            display: flex;
            height: 100vh;
            width: 100%;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
        }

        .form-panel {
            max-width: 480px;
            width: 100%;
            padding: 60px 40px;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
        }

        .form-panel h1 {
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 8px;
        }

        .form-panel p.subtitle {
            font-weight: 400;
            font-size: 0.875rem;
            margin-bottom: 40px;
            color: #555;
        }

        label {
            font-weight: 700;
            font-size: 0.75rem;
            display: block;
            margin-bottom: 4px;
        }

        input[type="password"] {
            width: 100%;
            height: 32px;
            padding: 6px 12px;
            font-size: 0.875rem;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            outline: none;
            margin-bottom: 20px;
            box-sizing: border-box;
            color: #000;
        }

        input[type="password"]::placeholder {
            color: #a0aec0;
        }

        button.submit-btn {
            width: 100%;
            padding: 10px 0;
            background-color: #45621d;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            cursor: pointer;
            margin-top: 10px;
            margin-bottom: 16px;
            transition: background-color 0.2s ease;
        }

        button.submit-btn:hover {
            background-color: #364c15;
        }

        .password-requirements {
            font-size: 0.75rem;
            color: #666;
            margin-bottom: 20px;
            padding: 12px;
            background-color: #f8f9fa;
            border-radius: 6px;
            border-left: 3px solid #45621d;
        }

        .password-requirements ul {
            margin: 8px 0 0 0;
            padding-left: 20px;
        }

        .password-requirements li {
            margin-bottom: 4px;
        }

        .back-to-login {
            text-align: center;
            font-size: 0.875rem;
            margin-top: 20px;
        }

        .back-to-login a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
        }

        .back-to-login a:hover {
            text-decoration: underline;
        }

        .flash-messages {
            margin-bottom: 20px;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 12px;
            font-size: 0.875rem;
        }

        .alert-success {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #6ee7b7;
        }

        .alert-error {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-panel">
            <h1>Nouveau mot de passe</h1>
            <p class="subtitle">Choisissez un nouveau mot de passe sécurisé pour votre compte</p>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-error">{{ message }}</div>
            {% endfor %}

            <form method="POST" action="{{ path('auth_reset_password', {token: token}) }}">
                <label for="password">NOUVEAU MOT DE PASSE</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    placeholder="••••••••" 
                    required 
                    minlength="6"
                />

                <label for="confirm_password">CONFIRMER LE MOT DE PASSE</label>
                <input 
                    type="password" 
                    id="confirm_password" 
                    name="confirm_password" 
                    placeholder="••••••••" 
                    required 
                    minlength="6"
                />

                <div class="password-requirements">
                    <strong>Exigences du mot de passe :</strong>
                    <ul>
                        <li>Au moins 6 caractères</li>
                        <li>Les deux mots de passe doivent correspondre</li>
                    </ul>
                </div>

                <button type="submit" class="submit-btn">Réinitialiser le mot de passe</button>
            </form>

            <div class="back-to-login">
                <a href="{{ path('auth_login') }}">← Retour à la connexion</a>
            </div>
        </div>
    </div>
</body>
</html>


