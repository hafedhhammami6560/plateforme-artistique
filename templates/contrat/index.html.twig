{% extends 'base.html.twig' %}

{% block title %}Mes Contrats{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-file-earmark-text"></i> Mes Contrats</h1>
        <a href="{{ path('app_contrat_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nouveau Contrat
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Barre de recherche et filtres #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('app_contrat_index') }}" class="row g-3">
                <div class="col-md-3">
                    <label for="search" class="form-label">Rechercher</label>
                    <input type="text" class="form-control" id="search" name="search" 
                           value="{{ search }}" placeholder="Numéro, utilisateur, project...">
                </div>
                
                <div class="col-md-2">
                    <label for="type" class="form-label">Type</label>
                    <select class="form-select" id="type" name="type">
                        <option value="">Tous</option>
                        <option value="publication_rights" {% if typeFilter == 'publication_rights' %}selected{% endif %}>Publication Rights</option>
                        <option value="custom_order" {% if typeFilter == 'custom_order' %}selected{% endif %}>Custom Order</option>
                    </select>
                </div>
                
                <div class="col-md-2">
                    <label for="statut" class="form-label">Statut</label>
                    <select class="form-select" id="statut" name="statut">
                        <option value="">Tous</option>
                        <option value="brouillon" {% if statutFilter == 'brouillon' %}selected{% endif %}>Brouillon</option>
                        <option value="en_attente_signature" {% if statutFilter == 'en_attente_signature' %}selected{% endif %}>En attente</option>
                        <option value="signe" {% if statutFilter == 'signe' %}selected{% endif %}>Signé</option>
                    </select>
                </div>
                
                <div class="col-md-3">
                    <label for="sort" class="form-label">Trier par</label>
                    <select class="form-select" id="sort" name="sort">
                        <option value="date_desc" {% if sortBy == 'date_desc' %}selected{% endif %}>Date (récent)</option>
                        <option value="date_asc" {% if sortBy == 'date_asc' %}selected{% endif %}>Date (ancien)</option>
                        <option value="montant_desc" {% if sortBy == 'montant_desc' %}selected{% endif %}>Montant (élevé)</option>
                        <option value="montant_asc" {% if sortBy == 'montant_asc' %}selected{% endif %}>Montant (faible)</option>
                        <option value="numero_asc" {% if sortBy == 'numero_asc' %}selected{% endif %}>Numéro (A-Z)</option>
                        <option value="numero_desc" {% if sortBy == 'numero_desc' %}selected{% endif %}>Numéro (Z-A)</option>
                    </select>
                </div>
                
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Filtrer
                    </button>
                    <a href="{{ path('app_contrat_index') }}" class="btn btn-outline-secondary" title="Réinitialiser les filtres">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    {% if contrats is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Aucun contrat trouvé.
            {% if search or typeFilter or statutFilter %}
                <a href="{{ path('app_contrat_index') }}">Réinitialiser les filtres</a>
            {% endif %}
        </div>
    {% else %}
        <div class="mb-3">
            <strong>{{ contrats|length }}</strong> contrat(s) trouvé(s)
        </div>
        <div class="row">
            {% for contrat in contrats %}
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <div class="d-flex justify-content-between">
                                <strong>{{ contrat.numeroContrat }}</strong>
                                {% if contrat.statut == 'signe' %}
                                    <span class="badge bg-success">Signé</span>
                                {% elseif contrat.statut == 'en_attente_signature' %}
                                    <span class="badge bg-warning">En attente signature</span>
                                {% else %}
                                    <span class="badge bg-secondary">Brouillon</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">
                                {% if contrat.type == 'publication_rights' %}
                                    <span class="badge bg-primary">Publication Rights</span>
                                {% else %}
                                    <span class="badge bg-success">Custom Order</span>
                                {% endif %}
                            </h5>
                            
                            <p class="card-text">
                                <strong>Montant:</strong> {{ contrat.prix }}€<br>
                                <strong>Période:</strong> {{ contrat.dateDebut|date('d/m/Y') }} - {{ contrat.dateFin|date('d/m/Y') }}
                            </p>

                            {% if contrat.project %}
                                <p><strong>project:</strong> {{ contrat.project.nom }}</p>
                            {% endif %}

                            {# Statut des signatures avec boutons #}
                            {% set currentUserId = app.request.cookies.get('user_id')|number_format(0, '', '') %}
                            <div class="mb-3">
                                {# Signature Artiste #}
                                <div class="d-flex justify-content-between align-items-center mb-2 p-2 border rounded">
                                    <div>
                                        <strong>Artiste:</strong> {{ contrat.artiste.name }}
                                    </div>
                                    <div>
                                        {% if contrat.signatureArtist %}
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Signé</span>
                                        {% else %}
                                            {% if contrat.artiste.id|number_format(0, '', '') == currentUserId and contrat.statut in ['en_attente_signature', 'final'] %}
                                                {% if contrat.artiste.hasSignature() %}
                                                    <form method="post" action="{{ path('app_signature_sign', {id: contrat.id}) }}" style="display:inline;" 
                                                          onsubmit="return confirm('Signer ce contrat ?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('sign_contract_' ~ contrat.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-success">
                                                            <i class="bi bi-pen"></i> Signer
                                                        </button>
                                                    </form>
                                                {% else %}
                                                    <a href="{{ path('app_profile_edit') }}" class="btn btn-sm btn-warning btn-sm">
                                                        <i class="bi bi-exclamation-triangle"></i> Ajouter signature
                                                    </a>
                                                {% endif %}
                                            {% else %}
                                                <span class="badge bg-warning text-dark">En attente</span>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>

                                {# Signature Client #}
                                <div class="d-flex justify-content-between align-items-center p-2 border rounded">
                                    <div>
                                        <strong>Client:</strong> {{ contrat.producteur.name }}
                                    </div>
                                    <div>
                                        {% if contrat.signatureClient %}
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Signé</span>
                                        {% else %}
                                            {% if contrat.producteur.id|number_format(0, '', '') == currentUserId and contrat.statut in ['en_attente_signature', 'final'] %}
                                                {% if contrat.producteur.hasSignature() %}
                                                    <form method="post" action="{{ path('app_signature_sign', {id: contrat.id}) }}" style="display:inline;" 
                                                          onsubmit="return confirm('Signer ce contrat ?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('sign_contract_' ~ contrat.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-success">
                                                            <i class="bi bi-pen"></i> Signer
                                                        </button>
                                                    </form>
                                                {% else %}
                                                    <a href="{{ path('app_profile_edit') }}" class="btn btn-sm btn-warning">
                                                        <i class="bi bi-exclamation-triangle"></i> Ajouter signature
                                                    </a>
                                                {% endif %}
                                            {% else %}
                                                <span class="badge bg-warning text-dark">En attente</span>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <a href="{{ path('app_contrat_show', {id: contrat.id}) }}" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Voir détails
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}


