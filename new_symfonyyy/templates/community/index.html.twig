{% extends 'base.html.twig' %}

{% block title %}Communities{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-users"></i> Communities</h1>
        <a href="{{ path('app_community_new') }}" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
            <i class="fas fa-plus"></i> New Community
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <!-- Filtres et recherche -->
    <div class="card shadow-sm mb-3">
        <div class="card-header" style="background-color: #f8f9fa;">
            <h5 class="mb-0"><i class="fas fa-filter"></i> Search & Filters</h5>
        </div>
        <div class="card-body">
            <form method="get" action="{{ path('app_community_index') }}" class="row g-3">
                <div class="col-md-4">
                    <label for="search" class="form-label"><i class="fas fa-search"></i> Search</label>
                    <input type="text" class="form-control" id="search" name="search" value="{{ search }}" placeholder="Name, slug or description...">
                </div>
                <div class="col-md-3">
                    <label for="type" class="form-label"><i class="fas fa-tag"></i> Type</label>
                    <select class="form-control" id="type" name="type">
                        <option value="">All Types</option>
                        <option value="general" {% if type == 'general' %}selected{% endif %}>General</option>
                        <option value="artist" {% if type == 'artist' %}selected{% endif %}>Artist</option>
                        <option value="category" {% if type == 'category' %}selected{% endif %}>Category</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="privacy" class="form-label"><i class="fas fa-lock"></i> Privacy</label>
                    <select class="form-control" id="privacy" name="privacy">
                        <option value="">All</option>
                        <option value="0" {% if privacy == '0' %}selected{% endif %}>Public</option>
                        <option value="1" {% if privacy == '1' %}selected{% endif %}>Private</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="sort" class="form-label"><i class="fas fa-sort"></i> Sort By</label>
                    <select class="form-control" id="sort" name="sort">
                        <option value="name" {% if sortBy == 'name' %}selected{% endif %}>Name</option>
                        <option value="slug" {% if sortBy == 'slug' %}selected{% endif %}>Slug</option>
                        <option value="type" {% if sortBy == 'type' %}selected{% endif %}>Type</option>
                        <option value="createdAt" {% if sortBy == 'createdAt' %}selected{% endif %}>Created Date</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label for="order" class="form-label">Order</label>
                    <select class="form-control" id="order" name="order">
                        <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>↑ ASC</option>
                        <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>↓ DESC</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
                        <i class="fas fa-search"></i> Apply Filters
                    </button>
                    <a href="{{ path('app_community_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-redo"></i> Reset
                    </a>
                    <span class="text-muted ms-3">
                        <i class="fas fa-info-circle"></i> {{ communities|length }} result(s)
                    </span>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            {% if communities|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead style="background-color: #344BE2; color: white;">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Type</th>
                            <th>Privacy</th>
                            <th>Members</th>
                            <th>Posts</th>
                            <th>Created</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for community in communities %}
                        <tr>
                            <td>{{ community.id }}</td>
                            <td><strong>{{ community.name }}</strong></td>
                            <td><code>{{ community.slug }}</code></td>
                            <td>
                                {% if community.type == 'artist' %}
                                    <span class="badge bg-info">Artist</span>
                                {% elseif community.type == 'category' %}
                                    <span class="badge bg-warning">Category</span>
                                {% else %}
                                    <span class="badge bg-secondary">General</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if community.isPrivate %}
                                    <span class="badge bg-danger"><i class="fas fa-lock"></i> Private</span>
                                {% else %}
                                    <span class="badge bg-success"><i class="fas fa-globe"></i> Public</span>
                                {% endif %}
                            </td>
                            <td>{{ community.memberships|length }}</td>
                            <td>{{ community.posts|length }}</td>
                            <td>{{ community.createdAt|date('Y-m-d') }}</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="{{ path('app_community_show', {'id': community.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_community_edit', {'id': community.id}) }}" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No communities found. Create your first community!</p>
                    <a href="{{ path('app_community_new') }}" class="btn btn-primary" style="background-color: #344BE2;">
                        <i class="fas fa-plus"></i> Create Community
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    .btn-group .btn {
        margin: 0 2px;
    }
</style>
{% endblock %}
