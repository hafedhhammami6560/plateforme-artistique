{% extends 'base.html.twig' %}

{% block title %}Communities{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-users"></i> Communities</h1>
        <a href="{{ path('app_community_new') }}" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
            <i class="fas fa-plus"></i> New Community
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            {% if communities|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead style="background-color: #344BE2; color: white;">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Type</th>
                            <th>Privacy</th>
                            <th>Members</th>
                            <th>Posts</th>
                            <th>Created</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for community in communities %}
                        <tr>
                            <td>{{ community.id }}</td>
                            <td><strong>{{ community.name }}</strong></td>
                            <td><code>{{ community.slug }}</code></td>
                            <td>
                                {% if community.type == 'artist' %}
                                    <span class="badge bg-info">Artist</span>
                                {% elseif community.type == 'category' %}
                                    <span class="badge bg-warning">Category</span>
                                {% else %}
                                    <span class="badge bg-secondary">General</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if community.isPrivate %}
                                    <span class="badge bg-danger"><i class="fas fa-lock"></i> Private</span>
                                {% else %}
                                    <span class="badge bg-success"><i class="fas fa-globe"></i> Public</span>
                                {% endif %}
                            </td>
                            <td>{{ community.memberships|length }}</td>
                            <td>{{ community.posts|length }}</td>
                            <td>{{ community.createdAt|date('Y-m-d') }}</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="{{ path('app_community_show', {'id': community.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_community_edit', {'id': community.id}) }}" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No communities found. Create your first community!</p>
                    <a href="{{ path('app_community_new') }}" class="btn btn-primary" style="background-color: #344BE2;">
                        <i class="fas fa-plus"></i> Create Community
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    .btn-group .btn {
        margin: 0 2px;
    }
</style>
{% endblock %}
