{% extends 'base.html.twig' %}

{% block title %}{{ community.name }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header" style="background-color: #344BE2; color: white;">
                    <h3 class="mb-0"><i class="fas fa-users"></i> {{ community.name }}</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-muted">Slug</h6>
                        <code>{{ community.slug }}</code>
                    </div>

                    {% if community.description %}
                    <div class="mb-3">
                        <h6 class="text-muted">Description</h6>
                        <p>{{ community.description }}</p>
                    </div>
                    {% endif %}

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <h6 class="text-muted">Type</h6>
                            {% if community.type == 'artist' %}
                                <span class="badge bg-info">Artist</span>
                            {% elseif community.type == 'category' %}
                                <span class="badge bg-warning">Category</span>
                            {% else %}
                                <span class="badge bg-secondary">General</span>
                            {% endif %}
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted">Privacy</h6>
                            {% if community.isPrivate %}
                                <span class="badge bg-danger"><i class="fas fa-lock"></i> Private</span>
                            {% else %}
                                <span class="badge bg-success"><i class="fas fa-globe"></i> Public</span>
                            {% endif %}
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted">Created</h6>
                            {{ community.createdAt|date('F d, Y') }}
                        </div>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_community_index') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                        <div>
                            <a href="{{ path('app_community_edit', {'id': community.id}) }}" class="btn btn-warning">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mb-3">
                <div class="card-body text-center">
                    <h5>Members</h5>
                    <h2 class="text-primary">{{ community.memberships|length }}</h2>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Posts</h5>
                    <h2 class="text-success">{{ community.posts|length }}</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the community <strong>{{ community.name }}</strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="{{ path('app_community_delete', {'id': community.id}) }}" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ community.id) }}">
                    <button type="submit" class="btn btn-danger">Delete Community</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
