{% extends 'base.html.twig' %}

{% block title %}Mes Discussions - ArtConnect{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-chat-dots"></i> Mes Discussions
                </h1>
                {% if is_granted('ROLE_PUBLISHER') %}
                    <a href="{{ path('app_discussion_new') }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Nouvelle Discussion
                    </a>
                {% endif %}
            </div>

            <!-- Statistics -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2">Total</h6>
                            <h2 class="card-title mb-0">{{ stats.total }}</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2">Actives</h6>
                            <h2 class="card-title mb-0">{{ stats.active }}</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-secondary text-white">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2">Fermées</h6>
                            <h2 class="card-title mb-0">{{ stats.closed }}</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2">Avec Contrat</h6>
                            <h2 class="card-title mb-0">{{ stats.withContract }}</h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Discussions List -->
            {% if discussions is empty %}
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Vous n'avez aucune discussion pour le moment.
                    {% if is_granted('ROLE_PUBLISHER') %}
                        <a href="{{ path('app_discussion_new') }}" class="alert-link">Créer une nouvelle discussion</a>
                    {% endif %}
                </div>
            {% else %}
                <div class="row g-3">
                    {% for discussion in discussions %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">Discussion #{{ discussion.id }}</span>
                                    {% if discussion.status == 'active' %}
                                        <span class="badge bg-success status-badge">Active</span>
                                    {% elseif discussion.status == 'pending' %}
                                        <span class="badge bg-warning text-dark status-badge">En attente</span>
                                    {% elseif discussion.status == 'closed' %}
                                        <span class="badge bg-secondary status-badge">Fermée</span>
                                    {% else %}
                                        <span class="badge bg-dark status-badge">{{ discussion.statusLabel }}</span>
                                    {% endif %}
                                </div>
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-palette"></i> {{ discussion.product.title }}
                                    </h6>
                                    <p class="card-text text-muted small mb-2">
                                        {% set subj = discussion.subject|default('Sans sujet') %}
                                        {{ subj|length > 80 ? subj|slice(0, 80) ~ '...' : subj }}
                                    </p>
                                    <hr>
                                    <div class="row g-2 small align-items-center">
                                        <div class="col-6">
                                            <strong>Artiste:</strong><br>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="{{ discussion.artist.avatar }}" alt="{{ discussion.artist.fullName }}" class="rounded-circle" width="32" height="32">
                                                <span><i class="bi bi-person"></i> {{ discussion.artist.username }}</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <strong>Publisher:</strong><br>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="{{ discussion.publisher.avatar }}" alt="{{ discussion.publisher.fullName }}" class="rounded-circle" width="32" height="32">
                                                <span><i class="bi bi-building"></i> {{ discussion.publisher.username }}</span>
                                            </div>
                                        </div>
                                    </div>
                                    {% if discussion.product.image %}
                                        <div class="mt-3">
                                            <img src="{{ discussion.product.image }}" alt="{{ discussion.product.title }}" class="img-fluid rounded" style="max-height: 160px; object-fit: cover; width: 100%;">
                                        </div>
                                    {% endif %}
                                    <hr>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="bi bi-chat"></i> {{ discussion.messageCount }} message{{ discussion.messageCount > 1 ? 's' : '' }}
                                        </small>
                                        {% if discussion.hasContract %}
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Contrat
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="card-footer bg-white d-flex justify-content-between">
                                    <small class="text-muted">
                                        {{ discussion.createdAt|date('d/m/Y à H:i') }}
                                    </small>
                                    <a href="{{ path('app_discussion_show', {id: discussion.id}) }}" class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
