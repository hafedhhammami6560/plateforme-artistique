{% extends 'base.html.twig' %}

{% block title %}Liste des Contrats{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="fas fa-file-contract"></i> Mes Contrats
        </h1>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>N° Contrat</th>
                <th>Producteur</th>
                <th>Artiste</th>
                <th>Montant</th>
                <th>Date début</th>
                <th>Date fin</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for contrat in contrats %}
            <tr>
                <td><strong>{{ contrat.numeroContrat }}</strong></td>
                <td>{{ contrat.producteur.name }}</td>
                <td>{{ contrat.artiste.name }}</td>
                <td>{{ contrat.montant|number_format(2, ',', ' ') }} €</td>
                <td>{{ contrat.dateDebut ? contrat.dateDebut|date('d/m/Y') : '' }}</td>
                <td>{{ contrat.dateFin ? contrat.dateFin|date('d/m/Y') : '' }}</td>
                <td>
                    {% if contrat.statut == 'EN_ATTENTE' %}
                        <span class="badge bg-warning">En attente</span>
                    {% elseif contrat.statut == 'ACCEPTE' %}
                        <span class="badge bg-success">Accepté</span>
                    {% elseif contrat.statut == 'ACTIF' %}
                        <span class="badge bg-primary">Actif</span>
                    {% elseif contrat.statut == 'TERMINE' %}
                        <span class="badge bg-secondary">Terminé</span>
                    {% else %}
                        <span class="badge bg-danger">Annulé</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_contrat_show', {'id': contrat.id}) }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('app_contrat_edit', {'id': contrat.id}) }}" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8" class="text-center text-muted py-5">
                    <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                    <p>Aucun contrat trouvé</p>
                    <a href="{{ path('app_contrat_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Créer votre premier contrat
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
