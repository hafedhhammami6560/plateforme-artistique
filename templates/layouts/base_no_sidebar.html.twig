<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>{% block title %}ArtConnect{% endblock %}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		<style>
			body { font-family: 'Segoe UI', Arial, sans-serif; background:#f7f9fc; margin:0; color:#1a202c; }
			header { background:white; box-shadow:0 2px 6px rgba(0,0,0,0.08); padding:14px 24px; position:sticky; top:0; z-index:10; }
			.nav-inline { display:flex; align-items:center; justify-content:space-between; gap:20px; }
			.nav-inline .brand { font-weight:800; font-size:1.1rem; color:#2b2f36; text-decoration:none; display:flex; align-items:center; gap:10px; }
			.nav-inline .brand i { color:#4c6ef5; }
			.nav-inline .links { display:flex; gap:16px; }
			.nav-inline .links a { text-decoration:none; color:#2b2f36; font-weight:600; padding:8px 10px; border-radius:6px; transition:background 0.2s; }
			.nav-inline .links a:hover { background:#e9edf7; }
			main { max-width:1200px; margin:30px auto; padding:0 20px; }
		</style>
	</head>
	<body>
		<header>
			<div class="nav-inline">
				<a class="brand" href="{{ path('app_project_index') }}"><i class="fas fa-project-diagram"></i> ArtConnect</a>
				<div class="links">
					<a href="{{ path('app_project_index') }}">Projets</a>
				</div>
			</div>
		</header>
		<main>
			{% block body %}{% endblock %}
		</main>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	</body>
</html>
