{% extends 'base.html.twig' %}

{% block title %}Organisations{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-building"></i> Organisations</h1>
        <a href="{{ path('organisation_new') }}" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
            <i class="fas fa-plus"></i> New Organisation
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <!-- Filtres et recherche -->
    <div class="card shadow-sm mb-3">
        <div class="card-header" style="background-color: #f8f9fa;">
            <h5 class="mb-0"><i class="fas fa-filter"></i> Search & Filters</h5>
        </div>
        <div class="card-body">
            <form method="get" action="{{ path('organisation_index') }}" class="row g-3">
                <div class="col-md-5">
                    <label for="search" class="form-label"><i class="fas fa-search"></i> Search</label>
                    <input type="text" class="form-control" id="search" name="search" value="{{ search }}" placeholder="Name, email or address...">
                </div>
                <div class="col-md-3">
                    <label for="communite" class="form-label"><i class="fas fa-users"></i> Community</label>
                    <select class="form-control" id="communite" name="communite">
                        <option value="">All Communities</option>
                        {% for c in communites %}
                            <option value="{{ c.id }}" {% if communiteId == c.id %}selected{% endif %}>{{ c.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="sort" class="form-label"><i class="fas fa-sort"></i> Sort By</label>
                    <select class="form-control" id="sort" name="sort">
                        <option value="name" {% if sortBy == 'name' %}selected{% endif %}>Name</option>
                        <option value="email" {% if sortBy == 'email' %}selected{% endif %}>Email</option>
                        <option value="createdBy" {% if sortBy == 'createdBy' %}selected{% endif %}>Created By</option>
                        <option value="createdAt" {% if sortBy == 'createdAt' %}selected{% endif %}>Created Date</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="order" class="form-label">Order</label>
                    <select class="form-control" id="order" name="order">
                        <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>↑ ASC</option>
                        <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>↓ DESC</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary" style="background-color: #344BE2; border-color: #344BE2;">
                        <i class="fas fa-search"></i> Apply Filters
                    </button>
                    <a href="{{ path('organisation_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-redo"></i> Reset
                    </a>
                    <span class="text-muted ms-3">
                        <i class="fas fa-info-circle"></i> {{ organisations|length }} result(s)
                    </span>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            {% if organisations|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead style="background-color: #344BE2; color: white;">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Community</th>
                            <th>Created By</th>
                            <th>Created At</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for o in organisations %}
                        <tr>
                            <td>{{ o.id }}</td>
                            <td><strong>{{ o.name }}</strong></td>
                            <td>{{ o.email ?? '-' }}</td>
                            <td>{{ o.address ?? '-' }}</td>
                            <td>
                                {% if o.communite %}
                                    <span class="badge bg-info">{{ o.communite.name }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">None</span>
                                {% endif %}
                            </td>
                            <td>{{ o.createdBy }}</td>
                            <td>{{ o.createdAt|date('Y-m-d') }}</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="{{ path('organisation_show', {'id': o.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('organisation_edit', {'id': o.id}) }}" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-building fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No organisations found. Create your first organisation!</p>
                    <a href="{{ path('organisation_new') }}" class="btn btn-primary" style="background-color: #344BE2;">
                        <i class="fas fa-plus"></i> Create Organisation
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    .btn-group .btn {
        margin: 0 2px;
    }
</style>
{% endblock %}
