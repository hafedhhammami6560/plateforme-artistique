{% extends 'base.html.twig' %}

{% block title %}Connexion Administrateur{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg">
                <div class="card-header text-center" style="background-color: #05468b; color: white;">
                    <h3 class="mb-0"><i class="fas fa-lock"></i> Connexion Administrateur</h3>
                </div>
                <div class="card-body p-4">
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle"></i> {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('info') %}
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            <i class="fas fa-info-circle"></i> {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    <form method="post">
                        <div class="mb-3">
                            <label for="username" class="form-label">
                                <i class="fas fa-user"></i> Nom d'utilisateur
                            </label>
                            <input type="text" class="form-control" id="username" name="username" required autofocus placeholder="admin">
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">
                                <i class="fas fa-key"></i> Mot de passe
                            </label>
                            <input type="password" class="form-control" id="password" name="password" required placeholder="admin123">
                        </div>

                        <div class="alert alert-info small">
                            <i class="fas fa-info-circle"></i> <strong>Identifiants de test :</strong><br>
                            Utilisateur : <code>admin</code><br>
                            Mot de passe : <code>admin123</code>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" style="background-color: #05468b; border-color: #05468b;">
                                <i class="fas fa-sign-in-alt"></i> Se connecter
                            </button>
                            <a href="{{ path('communite_index') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Retour
                            </a>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center text-muted small">
                    <i class="fas fa-shield-alt"></i> Accès réservé aux administrateurs
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        overflow: hidden;
    }
    .form-control:focus {
        border-color: #05468b;
        box-shadow: 0 0 0 0.2rem rgba(52, 75, 226, 0.25);
    }
</style>
{% endblock %}
