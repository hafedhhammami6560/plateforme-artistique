{% extends 'backoffice/base.html.twig' %}

{% block title %}Éditer Contrat - ArtConnect{% endblock %}
{% block page_title %}Éditer Contrat{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil"></i> Éditer le Contrat {{ contract.referenceNumber }}
                    </h4>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                        <div class="mb-4">
                            {{ form_row(form.terms) }}
                        </div>

                        <div class="mb-4">
                            {{ form_row(form.commissionRate) }}
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                {{ form_row(form.startDate) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.endDate) }}
                            </div>
                        </div>

                        <div class="mb-4">
                            {{ form_row(form.notes) }}
                        </div>

                        {% if form.status is defined %}
                            <div class="mb-4">
                                {{ form_row(form.status) }}
                            </div>
                        {% endif %}

                        <hr>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_contract_show', {id: contract.id}) }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-circle"></i> Sauvegarder
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
