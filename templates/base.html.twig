
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}ArtConnect Gallery{% endblock %}</title>

    {% block stylesheets %}
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Righteous&display=swap" rel="stylesheet">

        <style>
            /* ------- YOUR CSS (unchanged) ------- */
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }
            body {
                background-color: #054640;
                font-family: 'Poppins', sans-serif;
                color: #fff;
                line-height: 1.5;
                min-height: 100vh;
            }
            a {
                color: inherit;
                text-decoration: none;
                cursor: pointer;
            }
            .container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 20px 40px 60px;
                display: grid;
                grid-template-columns: repeat(12, 1fr);
                grid-gap: 30px;
                align-items: center;
            }
            header {
                grid-column: 1 / -1;
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 80px;
            }
            nav { display: flex; gap: 30px; font-weight: 500; font-size: 14px; }
            nav > ul {
                display: flex;
                list-style: none;
                gap: 30px;
                align-items: center;
            }
            nav > ul > li {
                position: relative;
                cursor: pointer;
            }
            nav > ul > li:hover > ul { display: block; }
            nav > ul > li > ul {
                position: absolute;
                top: 28px;
                left: 0;
                background-color: #0a6e53;
                padding: 8px 0;
                border-radius: 4px;
                display: none;
                min-width: 120px;
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
                z-index: 100;
            }
            nav > ul > li > ul > li {
                padding: 8px 15px;
                font-weight: 400;
                white-space: nowrap;
            }
            nav > ul > li > ul > li:hover { background-color: #07794e; }

            .logo {
                width: 130px;
                height: 86px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 800;
                font-size: 1.15rem;
                line-height: 1.1;
                cursor: default;
                user-select: none;
            }
            .logo svg { height: 40px; width: 40px; margin-bottom: 4px; fill: #fff; }

            .brand-name {
                font-style: italic;
                font-weight: 700;
                font-size: 1.2rem;
                letter-spacing: -0.04em;
            }

            .tagline {
                font-style: italic;
                font-weight: 500;
                font-size: 0.85rem;
                letter-spacing: -0.04em;
                color: #c1d7b9;
                margin-top: 4px;
            }

            .header-icons {
                display: flex;
                gap: 24px;
                font-size: 20px;
                color: #fff;
                cursor: pointer;
            }

            .header-icons svg {
                width: 20px;
                height: 20px;
                stroke: white;
                stroke-width: 1.75;
                fill: none;
                transition: stroke 0.2s ease;
            }

            .header-icons svg:hover { stroke: #a2d9b1; }

            .hero-text {
                grid-column: 1 / 6;
                display: flex;
                flex-direction: column;
                gap: 20px;
                max-width: 420px;
            }

            .hero-text h1 {
                font-weight: 700;
                font-size: 3rem;
                line-height: 1.2;
                font-family: 'Righteous', cursive;
                letter-spacing: 0.04em;
            }

            .hero-text p {
                line-height: 1.4;
                font-weight: 400;
                font-size: 0.92rem;
                color: #d6e9d2;
            }

            .btn-primary {
                background: #eef4f1;
                color: #054640;
                padding: 12px 30px;
                font-weight: 600;
                font-size: 1rem;
                border-radius: 4px;
                border: none;
                cursor: pointer;
                transition: background-color 0.25s ease;
                box-shadow: 0 2px 8px rgb(25 118 84 / 0.32);
            }
            .btn-primary:hover { background: #d6e9d2; }

            .btn-link {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                color: #eef4f1;
                font-weight: 500;
                font-size: 0.9rem;
                cursor: pointer;
                background: none;
                border: none;
                margin-left: 20px;
            }

            .btn-link:hover { color: #a2d9b1; }

            .btn-link svg {
                width: 14px;
                height: 14px;
                stroke: #eef4f1;
                stroke-width: 2;
                fill: none;
                transition: stroke 0.3s ease;
            }
            .btn-link:hover svg { stroke: #a2d9b1; }

            /* Rest of CSS = unchanged... */
        </style>
    {% endblock %}
</head>

<body>
<div class="container">
    <header>
        <nav>
            <ul>
                <li><a href="#">Shop</a></li>
                <li>
                    Products
                    <ul>
                        <li><a href="#">Paintings</a></li>
                        <li><a href="#">Sculptures</a></li>
                        <li><a href="#">Digital Art</a></li>
                    </ul>
                </li>
                <li><a href="#">Exhibitions</a></li>
                <li><a href="#">Guide</a></li>
            </ul>
        </nav>

        <div class="logo">
            <svg viewBox="0 0 64 64">
                <circle cx="32" cy="32" r="28" fill="none" stroke="#fff" stroke-width="3" />
                <circle cx="44" cy="20" r="4" fill="#fff" />
                <circle cx="35" cy="12" r="3" fill="#fff" />
                <circle cx="25" cy="20" r="3" fill="#fff" />
                <circle cx="22" cy="32" r="3" fill="#fff" />
                <circle cx="33" cy="38" r="4" fill="#fff" />
                <line x1="40" y1="46" x2="50" y2="62" stroke="#fff" stroke-width="3" stroke-linecap="round" />
            </svg>
            <span class="brand-name">ArtConnect</span>
            <span class="tagline">Gallery</span>
        </div>

        <div class="header-icons">
            <svg viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="7" />
                <line x1="20" y1="20" x2="16.65" y2="16.65" />
            </svg>

            <a href="{{ path('app_profile') }}">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="7" r="4" />
                    <path d="M5 21v-2a7 7 0 0114 0v2" />
                </svg>
            </a>

            <svg viewBox="0 0 24 24">
                <circle cx="9" cy="21" r="1" />
                <circle cx="20" cy="21" r="1" />
                <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 001.94-1.45l1.54-7.28H6" />
            </svg>
        </div>
    </header>

    {# Main dynamic content #}
    {% block body %}{% endblock %}
</div>

{% block javascripts %}{% endblock %}
</body>
</html>
