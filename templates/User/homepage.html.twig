<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ArtConnect Gallery</title>
  <style>
    /* Reset and base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #344BE2;
      font-family: 'Poppins', sans-serif;
      color: #fff;
      line-height: 1.5;
      min-height: 100vh;
    }

    a {
      color: inherit;
      text-decoration: none;
      cursor: pointer;
    }

    /* Container / Grid */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px 40px 60px;
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-gap: 30px;
      align-items: center;
    }

    /* Navigation */
    header {
      grid-column: 1 / -1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 80px;
    }

    nav {
      display: flex;
      gap: 30px;
      font-weight: 500;
      font-size: 14px;
    }

    nav > ul {
      display: flex;
      list-style: none;
      gap: 30px;
      align-items: center;
    }

    nav > ul > li {
      position: relative;
      cursor: pointer;
    }

    nav > ul > li:hover > ul {
      display: block;
    }

    nav > ul > li > ul {
      position: absolute;
      top: 28px;
      left: 0;
      background-color: #0a356eff;
      padding: 8px 0;
      border-radius: 4px;
      display: none;
      min-width: 120px;
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
      z-index: 100;
    }

    nav > ul > li > ul > li {
      padding: 8px 15px;
      font-weight: 400;
      white-space: nowrap;
    }

    nav > ul > li > ul > li:hover {
      background-color: #0a356eff;
    }

    /* Logo */
    .logo {
      width: 130px;
      height: 86px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      font-size: 1.15rem;
      line-height: 1.1;
      position: relative;
      cursor: default;
      user-select: none;
    }

    /* Updated logo SVG: paint palette with brush (simple silhouette) for artistic brand */
    .logo svg {
      height: 40px;
      width: 40px;
      margin-bottom: 4px;
      fill: #fff;
    }

    .logo .brand-name {
      font-style: italic;
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: -0.04em;
      line-height: 1;
    }

    .logo .tagline {
      font-style: italic;
      font-weight: 500;
      font-size: 0.85rem;
      letter-spacing: -0.04em;
      color: #c1d7b9;
      margin-top: 4px;
    }

    /* Header right icons */
    .header-icons {
      display: flex;
      gap: 24px;
      font-size: 20px;
      color: #fff;
      cursor: pointer;
    }

    .header-icons svg {
      width: 20px;
      height: 20px;
      stroke: white;
      stroke-width: 1.75;
      fill: none;
      transition: stroke 0.2s ease;
    }

    .header-icons svg:hover {
      stroke: #a2d9b1;
    }

    /* Hero main area */
    .hero-text {
      grid-column: 1 / 6;
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: 420px;
    }

    .hero-text h1 {
      font-weight: 700;
      font-size: 3rem;
      line-height: 1.2;
      font-family: 'Righteous', cursive;
      letter-spacing: 0.04em;
      max-width: 100%;
    }

    .hero-text p {
      line-height: 1.4;
      font-weight: 400;
      font-size: 0.92rem;
      color: #d6e9d2;
    }

    /* Buttons */
    .btn-primary {
      display: inline-block;
      background: #eef4f1;
      color: #0a356eff;
      padding: 12px 30px;
      font-weight: 600;
      font-size: 1rem;
      border-radius: 4px;
      border: none;
      cursor: pointer;
      transition: background-color 0.25s ease;
      box-shadow: 0 2px 8px rgb(25 118 84 / 0.32);
    }

    .btn-primary:hover {
      background: #d6e9d2;
    }

    .btn-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #eef4f1;
      font-weight: 500;
      font-size: 0.9rem;
      cursor: pointer;
      border: none;
      background: none;
      margin-left: 20px;
      transition: color 0.3s ease;
    }

    .btn-link:hover {
      color: #a2d9b1;
    }

    .btn-link svg {
      width: 14px;
      height: 14px;
      stroke: #eef4f1;
      stroke-width: 2;
      fill: none;
      transition: stroke 0.3s ease;
    }

    .btn-link:hover svg {
      stroke: #a2d9b1;
    }

    /* Hero images grid */
    .hero-images {
      grid-column: 7 / 13;
      display: grid;
      grid-template-columns: 1fr 2fr;
      grid-template-rows: repeat(2, 1fr);
      gap: 12px;
      max-width: 740px;
    }

    .hero-img-small-top,
    .hero-img-small-bottom,
    .hero-img-large {
      position: relative;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 6px 20px rgb(8 60 47 / 0.6);
      background-color: #ffffff;
    }

    .hero-img-small-top {
      grid-column: 1 / 2;
      grid-row: 1 / 2;
      height: 230px;
    }

    .hero-img-small-bottom {
      grid-column: 1 / 2;
      grid-row: 2 / 3;
      height: 230px;
    }

    .hero-img-large {
      grid-column: 2 / 3;
      grid-row: 1 / 3;
      height: 480px;
    }

    /* Label tags on images */
    .label-tag {
      background-color: #0a356eff;
      font-size: 11px;
      letter-spacing: 0.05em;
      padding: 4px 10px;
      border-radius: 2px;
      position: absolute;
      top: 14px;
      left: 12px;
      font-weight: 500;
      text-transform: capitalize;
      color: #eef4f1;
      user-select: none;
      box-shadow: inset 0 0 4px rgb(0 0 0 / 0.3);
      z-index: 2;
    }

    /* Images */
    .hero-images img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Large image content overlay */
    .hero-img-large-content {
      position: absolute;
      bottom: 20px;
      left: 20px;
      color: #eef4f1;
      background: linear-gradient(90deg, rgba(5, 70, 64, 0.88) 0%, rgba(0, 0, 0, 0) 100%);
      padding: 18px 20px 26px 20px;
      max-width: 320px;
      border-radius: 8px 0 0 8px;
      box-shadow: 0 4px 12px rgb(0 0 0 / 0.7);
      z-index: 3;
    }

    .hero-img-large-content h3 {
      font-weight: 600;
      margin-bottom: 6px;
      font-size: 1.3rem;
      line-height: 1.15;
    }

    .hero-img-large-content p {
      font-size: 0.9rem;
      line-height: 1.4;
      color: #ccdcd0;
      margin-bottom: 12px;
      max-width: 310px;
    }

    /* Read more button on large image */
    .read-more-btn {
      background: #eef4f1;
      border: none;
      padding: 8px 24px;
      border-radius: 2px;
      font-size: 0.9rem;
      font-weight: 600;
      color: #054640;
      cursor: pointer;
      box-shadow: 0 2px 8px rgb(25 118 84 / 0.32);
      transition: background-color 0.3s ease;
    }

    .read-more-btn:hover {
      background: #cde4d5;
    }

    /* Dot pattern */
    .dot-pattern {
      position: absolute;
      bottom: -50px;
      left: -20px;
      display: grid;
      grid-template-columns: repeat(5, 6px);
      grid-template-rows: repeat(5, 6px);
      gap: 8px 11px;
      opacity: 0.15;
      z-index: 1;
    }

    .dot-pattern span {
      width: 6px;
      height: 6px;
      background: #c7f2c9;
      border-radius: 50%;
      display: block;
    }

    /* Responsive adjustments */
    @media (max-width: 900px) {
      .container {
        grid-template-columns: 1fr 1fr;
        padding: 20px;
      }

      header {
        flex-wrap: wrap;
        margin-bottom: 40px;
      }

      nav > ul {
        gap: 15px;
        flex-wrap: wrap;
      }

      .hero-text {
        grid-column: 1 / -1;
        max-width: 100%;
      }

      .hero-text h1 {
        font-size: 2.2rem;
        max-width: 100%;
      }

      .hero-images {
        grid-column: 1 / -1;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto;
        gap: 10px;
        max-width: 100%;
      }

      .hero-img-small-top,
      .hero-img-small-bottom,
      .hero-img-large {
        height: 200px;
      }
    }

    @media (max-width: 480px) {
      header {
        justify-content: center;
        gap: 30px;
      }

      nav {
        display: none;
      }

      .header-icons {
        gap: 16px;
      }

      .container {
        padding-left: 20px;
        padding-right: 20px;
      }

      .hero-text h1 {
        font-size: 1.6rem;
        line-height: 1.2;
      }

      .hero-text p {
        font-size: 0.85rem;
      }

      .hero-images {
        grid-template-columns: 1fr;
        grid-template-rows: repeat(3, 200px);
      }

      .hero-img-large,
      .hero-img-small-top,
      .hero-img-small-bottom {
        height: 200px;
      }

      .dot-pattern {
        display: none;
      }
    }
  </style>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Righteous&display=swap" rel="stylesheet" />
</head>

<body>
  <div class="container">
    <header>
      <nav>
        <ul>
          <li><a href="#">Shop</a></li>
          <li>
            Products
            <ul>
              <li><a href="#">Paintings</a></li>
              <li><a href="#">Sculptures</a></li>
              <li><a href="#">Digital Art</a></li>
            </ul>
          </li>
          <li><a href="#">Exhibitions</a></li>
          <li><a href="#">Guide</a></li>
        </ul>
      </nav>

      <div class="logo" aria-label="ArtConnect logo" role="img">
        <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" role="img">
          <!-- Paint palette with brush simplified icon -->
          <circle cx="32" cy="32" r="28" fill="none" stroke="#fff" stroke-width="3" />
          <circle cx="44" cy="20" r="4" fill="#fff" />
          <circle cx="35" cy="12" r="3" fill="#fff" />
          <circle cx="25" cy="20" r="3" fill="#fff" />
          <circle cx="22" cy="32" r="3" fill="#fff" />
          <circle cx="33" cy="38" r="4" fill="#fff" />
          <line x1="40" y1="46" x2="50" y2="62" stroke="#fff" stroke-width="3" stroke-linecap="round" />
        </svg>
        <span class="brand-name">ArtConnect</span>
        <span class="tagline">Gallery</span>
      </div>

      <div class="header-icons" aria-label="User actions">
        <!-- Search icon -->
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7" />
          <line x1="20" y1="20" x2="16.65" y2="16.65" />
        </svg>
        <!-- User icon -->
        <a href="{{ path('app_profile') }}" aria-label="Go to profile">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="7" r="4" />
            <path d="M5 21v-2a7 7 0 0114 0v2" />
          </svg>
        </a>
        <!-- Cart icon -->
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 001.94-1.45l1.54-7.28H6" />
        </svg>
      </div>
    </header>

    <!-- Hero Text -->
    <section class="hero-text" aria-label="Main message">
      <h1>Happiness<br />blooms from<br />within</h1>
      <p>Our environment, the world in which we live and work, is a mirror of our attitudes and expectations.</p>

      <nav aria-label="Hero call to actions">
        <button class="btn-primary" type="button">Explore Art</button>
        <button class="btn-link" type="button" aria-label="Discover artists">
          Discover artists
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M6 4l4 4-4 4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </nav>
    </section>

    <!-- Hero Images - replaced plant images by artistic paintings -->
    <section class="hero-images" aria-label="Featured Artworks">
      <article class="hero-img-small-top" aria-label="New painting">
        <div class="label-tag">new</div>
        <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=600&q=80" alt="Abstract colorful painting with dynamic brush strokes" />
      </article>

      <article class="hero-img-small-bottom" aria-label="Popular sculpture">
        <div class="label-tag">popular</div>
        <img src="https://images.unsplash.com/photo-1549887534-48265ca52ad8?auto=format&fit=crop&w=600&q=80" alt="Modern sculpture with curved metallic structure" />
      </article>

      <article class="hero-img-large" aria-label="Featured digital artwork">
        <div class="label-tag">featured</div>
        <img src="https://images.unsplash.com/photo-1504198453319-5ce911bafcde?auto=format&fit=crop&w=800&q=80" alt="Digital art with vibrant colors and geometric shapes" />
        <div class="hero-img-large-content">
          <h3>Vivid Geometrics</h3>
          <p>An evocative digital piece blending vibrant color palettes with geometric forms to inspire perspectives and imagination.</p>
          <button class="read-more-btn" type="button" aria-label="Read more about Vivid Geometrics">Read more</button>
        </div>
      </article>

      <!-- Dot pattern bottom left in hero images -->
      <div class="dot-pattern" aria-hidden="true" style="grid-column: 1 / 2; grid-row: 2 / 3;">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </section>
  </div>
</body>

</html>
