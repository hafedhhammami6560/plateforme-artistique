{% extends 'base.html.twig' %}

{% block title %}{{ discussion.titre }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_discussion_index') }}">Discussions</a></li>
            <li class="breadcrumb-item active">{{ discussion.titre }}</li>
        </ol>
    </nav>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    {% if discussion.type == 'publication_rights' %}
                        <span class="badge bg-primary">Publication Rights</span>
                    {% else %}
                        <span class="badge bg-success">Custom Order</span>
                    {% endif %}
                    {{ discussion.titre }}
                </h2>
                <div>
                    {% if discussion.statut == 'en_cours' %}
                        <span class="badge bg-success">En cours</span>
                    {% else %}
                        <span class="badge bg-secondary">Terminée</span>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Initiateur:</strong> {{ discussion.initiateur.name }}</p>
                    <p><strong>Destinataire:</strong> {{ discussion.destinataire.name }}</p>
                </div>
                <div class="col-md-6">
                    {% if discussion.project %}
                        <p><strong>project:</strong> {{ discussion.project.nom }}</p>
                        <p><strong>Prix project:</strong> {{ discussion.project.prix }}€</p>
                    {% else %}
                        <p><em>Aucun project (commande personnalisée)</em></p>
                    {% endif %}
                </div>
            </div>

            {# Section Contrats/Brouillons #}
            <div class="mt-4">
                <h5><i class="bi bi-file-earmark-text"></i> Contrats et Brouillons</h5>
                <div class="alert alert-secondary small">
                    <i class="bi bi-info-circle"></i>
                    <strong>Workflow :</strong> Échangez des messages pour vous mettre d'accord sur les détails.
                    Créez des brouillons de contrat à chaque étape d'accord. Une fois tous les détails convenus,
                    marquez un brouillon comme "contrat final" et signez-le.
                </div>

                {# Contrat final lié #}
                {% if discussion.contrat %}
                    <div class="alert alert-success">
                        <i class="bi bi-file-earmark-check"></i>
                        <strong>Contrat final lié :</strong>
                        <a href="{{ path('app_contrat_show', {id: discussion.contrat.id}) }}" class="alert-link">
                            {{ discussion.contrat.numeroContrat }}
                        </a>
                        <span class="badge bg-{% if discussion.contrat.statut == 'signe' %}success{% elseif discussion.contrat.statut == 'final' %}warning{% else %}secondary{% endif %}">
                            {{ discussion.contrat.statut|upper }}
                        </span>
                    </div>
                {% endif %}

                {# Liste des brouillons #}
                {% if brouillons is defined and brouillons|length > 0 %}
                    <h6 class="mt-3">Brouillons créés ({{ brouillons|length }})</h6>
                    <div class="list-group mb-3">
                        {% for brouillon in brouillons %}
                            <a href="{{ path('app_contrat_show', {id: brouillon.id}) }}"
                               class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">
                                            <i class="bi bi-file-text"></i> {{ brouillon.numeroContrat }}
                                            <span class="badge bg-{% if brouillon.statut == 'brouillon' %}secondary{% elseif brouillon.statut == 'final' %}warning{% elseif brouillon.statut == 'signe' %}success{% else %}info{% endif %}">
                                                {{ brouillon.statut|upper }}
                                            </span>
                                        </h6>
                                        <small class="text-muted">
                                            Prix: {{ brouillon.prix }}€ |
                                            Créé le {{ brouillon.createdAt|date('d/m/Y à H:i') }}
                                        </small>
                                    </div>
                                    <i class="bi bi-chevron-right"></i>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted small mt-2">
                        <i class="bi bi-inbox"></i> Aucun brouillon de contrat créé pour le moment.
                    </p>
                {% endif %}

                {# Bouton pour créer un brouillon #}
                {% set currentUserId = app.request.cookies.get('user_id')|number_format(0, '', '') %}
                {% set isInitiateur = discussion.initiateur.id|number_format(0, '', '') == currentUserId %}
                {% set isDestinataire = discussion.destinataire.id|number_format(0, '', '') == currentUserId %}

                {% if discussion.statut == 'en_cours' and (isInitiateur or isDestinataire) %}
                    <div class="d-grid gap-2 mt-3">
                        <a href="{{ path('app_contrat_new', {discussion: discussion.id}) }}" class="btn btn-outline-primary">
                            <i class="bi bi-plus-circle"></i> Créer un nouveau brouillon de contrat
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h3 class="mb-0"><i class="bi bi-chat-left-text"></i> Messages</h3>
        </div>
        <div class="card-body">
            {% if discussion.messages is empty %}
                <p class="text-muted">Aucun message</p>
            {% else %}
                <div class="list-group list-group-flush">
                    {% for message in discussion.messages %}
                        <div class="list-group-item {% if user and message.auteur.id == user.id %}bg-light{% endif %}">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">
                                    {{ message.auteur.name }}
                                    {% if message.auteur.id == discussion.initiateur.id %}
                                        <span class="badge bg-primary">Initiateur</span>
                                    {% else %}
                                        <span class="badge bg-info">Destinataire</span>
                                    {% endif %}
                                </h6>
                                <small>{{ message.createdAt|date('d/m/Y H:i') }}</small>
                            </div>
                            <p class="mb-1">{{ message.contenu|nl2br }}</p>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if discussion.statut == 'en_cours' %}
                <hr class="my-4">
                <h5>Répondre</h5>
                <form method="post">
                    <div class="mb-3">
                        <label for="message" class="form-label">Message</label>
                        <textarea name="message" id="message" class="form-control" rows="3" placeholder="Tapez votre message..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send"></i> Envoyer
                    </button>
                </form>
            {% else %}
                <div class="alert alert-secondary mt-3">
                    <i class="bi bi-lock"></i> Discussion terminée - impossible d'ajouter des messages
                </div>
            {% endif %}
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a href="{{ path('app_discussion_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>

        <div>
            {% if discussion.statut == 'en_cours' %}
                <form method="post" action="{{ path('app_discussion_terminer', {id: discussion.id}) }}"
                      onsubmit="return confirm('Êtes-vous sûr de vouloir terminer cette discussion ?');" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('terminer' ~ discussion.id) }}">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-circle"></i> Terminer
                    </button>
                </form>
            {% endif %}

            {# Masquer la discussion (soft delete) #}
            <form method="post" action="{{ path('app_discussion_hide', {id: discussion.id}) }}"
                  onsubmit="return confirm('Voulez-vous masquer cette discussion de votre liste ? Elle ne sera pas supprimée définitivement.');" style="display: inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('hide_discussion_' ~ discussion.id) }}">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-eye-slash"></i> Masquer
                </button>
            </form>

            {# Supprimer définitivement (Admin seulement) #}
            {% set currentUser = app.request.cookies.get('user_id') %}
            {% if currentUser %}
                {% set userType = '' %}
                {# On ne peut pas facilement récupérer userType ici, on affiche le bouton pour tous #}
                <form method="post" action="{{ path('app_discussion_delete', {id: discussion.id}) }}"
                      onsubmit="return confirm('⚠️ ADMIN UNIQUEMENT ⚠️\n\nSupprimer définitivement cette discussion de la base de données ?\n\nCette action est irréversible !');" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_discussion_' ~ discussion.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Supprimer (Admin)
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}


