{% extends 'base.html.twig' %}

{% block title %}Nouveau Contrat{% endblock %}

{% block body %}
<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_contrat_index') }}">Contrats</a></li>
            <li class="breadcrumb-item active">Nouveau</li>
        </ol>
    </nav>

    <h1><i class="bi bi-file-earmark-plus"></i> Créer un Nouveau Contrat</h1>

    {% if discussion is defined and discussion %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Ce contrat est lié à la discussion avec <strong>{{ discussion.participant.name }}</strong>
        </div>
    {% endif %}

    <div class="card mt-4">
        <div class="card-body">
            {{ form_start(form) }}
                
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.artiste) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.producteur) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.type) }}
                    </div>
                    <div class="col-md-6">
                        {% if form.produit is defined %}
                            {{ form_row(form.produit) }}
                        {% endif %}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.prix) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.dateDebut) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.dateFin) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_row(form.conditionsTexte) }}
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_contrat_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Créer le Contrat
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

    <div class="alert alert-warning mt-4">
        <h5><i class="bi bi-exclamation-triangle"></i> À propos des contrats</h5>
        <ul class="mb-0">
            <li><strong>Type A (Publication Rights):</strong> Pour accorder des droits sur un produit existant</li>
            <li><strong>Type B (Custom Order):</strong> Pour une commande personnalisée (le produit sera créé après signature)</li>
            <li>Une fois créé, le contrat devra être signé par l'artiste puis le client</li>
            <li>Le contrat ne peut plus être modifié une fois qu'une signature est apposée</li>
        </ul>
    </div>
</div>
{% endblock %}
