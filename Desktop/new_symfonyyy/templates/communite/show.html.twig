{% extends 'base.html.twig' %}

{% block title %}Communauté {{ communite.name }}{% endblock %}

{% block body %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <h1>{{ communite.name }}</h1>
    <p>{{ communite.description }}</p>
    <p>Créée le {{ communite.createdAt|date('Y-m-d H:i') }}</p>
    <p>Créée par: {{ communite.createdBy ?: 'anonyme' }}</p>

    <h2>Organisations</h2>
    <ul>
        {% for org in communite.organisations %}
            <li><a href="{{ path('organisation_show', {id: org.id}) }}">{{ org.name }}</a></li>
        {% else %}
            <li>Aucune organisation.</li>
        {% endfor %}
    </ul>

    <div class="mt-4">
        <a href="{{ path('communite_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <a href="{{ path('communite_edit', {'id': communite.id}) }}" class="btn btn-warning">
            <i class="fas fa-edit"></i> Modifier
        </a>
        <form method="post" action="{{ path('communite_delete', {'id': communite.id}) }}" style="display: inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette communauté ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ communite.id) }}">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Supprimer
            </button>
        </form>
    </div>
{% endblock %}
